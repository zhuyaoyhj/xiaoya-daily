{
  "pages": [
    "pages/index/index",
    "pages/record/record",
    "pages/vaccine/vaccine",
    "pages/mine/mine",
    "pages/weather/weather",
    "pages/baby-edit/baby-edit",
    "pages/care-edit/care-edit"
  ],
  "permission": {
    "scope.userLocation": {
      "desc": "用于按宝宝所在小区的位置获取更准确的天气与穿衣建议"
    }
  },
  "requiredPrivateInfos": [
    "choosePoi",
    "chooseLocation",
    "getLocation"
  ],
  "window": {
    "backgroundTextStyle": "@bgTextStyle",
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTitleText": "小芽日常",
    "navigationBarTextStyle": "@navText",
    "backgroundColor": "@bgColor",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom"
  },
  "tabBar": {
    "color": "@tabColor",
    "selectedColor": "@tabSelected",
    "backgroundColor": "@tabBg",
    "borderStyle": "@tabBorder",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "今日",
        "iconPath": "@iconToday",
        "selectedIconPath": "@iconTodayOn"
      },
      {
        "pagePath": "pages/record/record",
        "text": "记录",
        "iconPath": "@iconRecord",
        "selectedIconPath": "@iconRecordOn"
      },
      {
        "pagePath": "pages/vaccine/vaccine",
        "text": "疫苗",
        "iconPath": "@iconVaccine",
        "selectedIconPath": "@iconVaccineOn"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "@iconMine",
        "selectedIconPath": "@iconMineOn"
      }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "privacy-popup": "/components/privacy-popup/privacy-popup"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "subPackages": [
    {
      "root": "pages/food",
      "name": "food",
      "pages": [
        "food"
      ]
    },
    {
      "root": "pages/food-edit",
      "name": "food-edit",
      "pages": [
        "food-edit"
      ]
    },
    {
      "root": "pages/meal-log",
      "name": "meal-log",
      "pages": [
        "meal-log"
      ]
    },
    {
      "root": "pages/vaccine-edit",
      "name": "vaccine-edit",
      "pages": [
        "vaccine-edit"
      ]
    },
    {
      "root": "pages/guide",
      "name": "guide",
      "pages": [
        "guide"
      ]
    },
    {
      "root": "pages/growth",
      "name": "growth",
      "pages": [
        "growth"
      ]
    },
    {
      "root": "pages/share",
      "name": "share",
      "pages": [
        "share"
      ]
    },
    {
      "root": "pages/place",
      "name": "place",
      "pages": [
        "place"
      ]
    },
    {
      "root": "pages/family",
      "name": "family",
      "pages": [
        "family"
      ]
    },
    {
      "root": "pages/sync",
      "name": "sync",
      "pages": [
        "sync"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "food",
        "meal-log",
        "food-edit",
        "vaccine-edit",
        "guide",
        "place",
        "share",
        "family"
      ]
    },
    "pages/record/record": {
      "network": "all",
      "packages": [
        "food",
        "meal-log",
        "food-edit",
        "growth",
        "vaccine-edit",
        "share"
      ]
    },
    "pages/vaccine/vaccine": {
      "network": "all",
      "packages": [
        "vaccine-edit"
      ]
    },
    "pages/mine/mine": {
      "network": "all",
      "packages": [
        "growth",
        "place",
        "family",
        "sync",
        "share"
      ]
    }
  }
}
