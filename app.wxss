/* app.wxss —— 全局设计系统
   配色：奶油底 + 蜜桃主色 + 鼠尾草绿辅助，走柔和亲和的母婴调性
   注意：WXSS 中禁止引用本地图片，所有氛围感一律用渐变实现 */

/* ==== design tokens（自动维护，见 tools/check.js） ==== */
page {
  /* 品牌 */
  --brand: #F0876B;
  --brand-strong: #D9724F;
  --brand-deep: #C4643F;
  --brand-light: #FFA07E;
  --brand-soft: #F5C4A8;
  --brand-tint: #FFF1E6;
  --on-brand: #FFFFFF; /* 彩色底上的文字：深色模式下仍是白色 */
  --glass: rgba(255, 255, 255, 0.5); /* 渐变头图上的半透明小块 */
  --glass-strong: rgba(255, 255, 255, 0.75);
  --shadow: rgba(213, 176, 147, 0.14); /* 卡片暖色投影 */
  --shadow-strong: rgba(213, 176, 147, 0.22);
  --peach-soft: #FFD8C3;
  --apricot: #F0B37E;
  /* 文字 */
  --text: #3A2E26;
  --text-2: #6B5A4D;
  --text-3: #8C7B6E;
  --text-4: #A8968A;
  --text-5: #C9B8A9;
  --text-warm: #A5836C;
  --shade: #40301F;
  --cocoa: #8A5A48;
  /* 表面 */
  --bg: #FFF8F0;
  --card: #FFFFFF;
  --sunken: #FBF6F0;
  --sunken-2: #F6ECE2;
  --line: #F2E6DA;
  --line-strong: #E3D2C3;
  /* 状态 */
  --danger: #C43C2A;
  --danger-text: #A8432F;
  --danger-soft: #FBEBE7;
  --warn: #A97A22;
  --warn-text: #8A6418;
  --warn-strong: #E0B15C;
  --warn-soft: #FDF4E3;
  --ok: #4B7C5C;
  --ok-soft: #EAF3EC;
  --info: #5B7FB8;
  --info-soft: #EEF4FB;
  /* 分类色 */
  --sleep: #7A6AA8;
  --sleep-light: #A88FC4;
  --sleep-muted: #9A8AA8;
  --sleep-soft: #F0EBFA;
  --sleep-line: #D9CEF0;
  --amber: #B4743F;
  --amber-soft: #F8E7C8;
  --olive: #9A8355;
  --leaf: #6E8F62;
  --leaf-light: #8FBF84;
  --sage: #5E7A6B;
  --mint: #7FB79A;
}
/* 深色模式：跟随系统（app.json darkmode: true）。只覆盖需要变的值 */
@media (prefers-color-scheme: dark) {
  page {
    --brand: #E8866A;
    --brand-strong: #F09A7E;
    --brand-deep: #F5A98F;
    --brand-light: #F0957A;
    --brand-soft: #7A4A3A;
    --brand-tint: #3A2A24;
    --peach-soft: #5C3C30;
    --apricot: #B98450;
    --text: #F2E8DF;
    --text-2: #D8C9BC;
    --text-3: #B5A597;
    --text-4: #8F8073;
    --text-5: #6B5E53;
    --text-warm: #C9A58C;
    --shade: #F7EEE6;
    --cocoa: #D8A895;
    --bg: #1C1714;
    --card: #27201C;
    --sunken: #211B17;
    --sunken-2: #2E2621;
    --line: #3A302A;
    --line-strong: #4A3E36;
    --danger: #F07A66;
    --danger-text: #F29A88;
    --danger-soft: #3D2420;
    --warn: #E0B15C;
    --warn-text: #EBC57E;
    --warn-strong: #E0B15C;
    --warn-soft: #3A3020;
    --ok: #7FB894;
    --ok-soft: #22332A;
    --info: #8FB0E0;
    --info-soft: #1F2A38;
    --sleep: #A898D8;
    --sleep-light: #B9A6DC;
    --sleep-muted: #A99ABA;
    --sleep-soft: #2A2438;
    --sleep-line: #4A4060;
    --amber: #D9A070;
    --amber-soft: #3A2E20;
    --olive: #C2AD80;
    --leaf: #9CC08E;
    --leaf-light: #8FBF84;
    --sage: #98B5A5;
    --mint: #7FB79A;
    --glass: rgba(0, 0, 0, 0.18);
    --glass-strong: rgba(0, 0, 0, 0.28);
    --shadow: rgba(0, 0, 0, 0.35);
    --shadow-strong: rgba(0, 0, 0, 0.45);
  }
}
/* ==== /design tokens ==== */
page {
  background-color: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
button,
input {
  box-sizing: border-box;
}

/* 去掉 button 默认边框与背景 */
button {
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: inherit;
  font-size: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.page-wrap {
  min-height: 100vh;
  padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--card);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 32rpx var(--shadow);
}

.card-flat {
  box-shadow: none;
  border: 2rpx solid var(--line);
}

/* ---------- 文字 ---------- */
.h1 {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.h2 {
  font-size: 34rpx;
  font-weight: 700;
}

.h3 {
  font-size: 30rpx;
  font-weight: 600;
}

.body {
  font-size: 28rpx;
  color: var(--text);
}

.muted {
  font-size: 24rpx;
  color: var(--text-3);
}

.tiny {
  font-size: 22rpx;
  color: var(--text-4);
}

.brand-text {
  color: var(--brand);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 40rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: transform 0.12s ease, opacity 0.12s ease;
}

.btn:active {
  transform: scale(0.975);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  box-shadow: 0 12rpx 28rpx rgba(240, 135, 107, 0.32);
}

.btn-ghost {
  background: var(--brand-tint);
  color: var(--brand-strong);
}

.btn-line {
  background: var(--card);
  color: var(--text);
  border: 2rpx solid var(--line);
}

.btn-block {
  width: 100%;
}

.btn-sm {
  height: 66rpx;
  padding: 0 28rpx;
  border-radius: 33rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.btn[disabled] {
  opacity: 0.5;
}

/* ---------- 小标签 ---------- */
.chip {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-plain {
  background: var(--sunken);
  color: var(--text-3);
}

.chip-active {
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
}

/* ---------- 分区标题 ---------- */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-warm);
}

/* ---------- 卡片标题 ---------- */
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

/* ---------- 分隔线 ---------- */
.divider {
  height: 2rpx;
  background: var(--sunken-2);
  margin: 24rpx 0;
}

.divider-dashed {
  height: 0;
  border-top: 2rpx dashed var(--line);
  margin: 24rpx 0;
}

/* ---------- 表单 ---------- */
.field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  border-bottom: 2rpx solid var(--sunken-2);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 180rpx;
  font-size: 28rpx;
  color: var(--text-2);
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  text-align: right;
}

.field-value {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  text-align: right;
}

.placeholder {
  color: var(--text-5);
}

/* ---------- 列表行 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.row-arrow {
  flex: none;
  display: flex;
  align-items: center;
}

/* 必须是 block：伪元素默认 inline，宽高不生效，会只剩一道竖线 */
.row-arrow::after {
  content: "";
  display: block;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--line-strong);
  border-right: 3rpx solid var(--line-strong);
  transform: rotate(45deg);
  margin-left: 12rpx;
}

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-emoji {
  font-size: 88rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

/* ---------- 安全区占位 ---------- */
.safe-bottom {
  height: calc(40rpx + env(safe-area-inset-bottom));
}
