/* 记录面板与计时条（配合 care-panel.wxml 模板使用） */

.cp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.42);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.cp-sheet {
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.cp-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.cp-sub {
  font-size: 24rpx;
  color: var(--text-4);
  line-height: 1.6;
  margin: 8rpx 0 24rpx;
}

.cp-sub-tight {
  margin: 28rpx 0 12rpx;
}

.cp-row {
  display: flex;
  gap: 20rpx;
}

.cp-big {
  flex: 1;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 32rpx 0;
  text-align: center;
  margin-top: 16rpx;
}

.cp-big:active {
  background: var(--brand-tint);
  border-color: var(--brand);
}

.cp-big-emoji {
  font-size: 48rpx;
  line-height: 1.2;
}

.cp-big-label {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.cp-big-hint {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.cp-divider {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-5);
  margin: 36rpx 0 20rpx;
}

.cp-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cp-chip {
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.cp-chip-on {
  color: var(--card);
  background: var(--brand);
  border-color: var(--brand);
}

.cp-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.cp-ml {
  flex: 1;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.cp-ml:active {
  background: var(--brand-tint);
  border-color: var(--brand);
}

.cp-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-4);
  margin-left: 2rpx;
}

.cp-input-row {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cp-input {
  flex: 1;
  height: 84rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.cp-input-btn {
  flex: none;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 36rpx;
  border-radius: 20rpx;
  background: var(--brand);
  color: var(--card);
  font-size: 28rpx;
  font-weight: 600;
}

.cp-colors {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 0;
}

.cp-color {
  width: 25%;
  text-align: center;
}

.cp-color:active {
  opacity: 0.7;
}

.cp-swatch {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin: 0 auto;
  border: 4rpx solid var(--card);
  box-shadow: 0 4rpx 14rpx rgba(58, 46, 38, 0.15);
}

.cp-color-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.cp-skip,
.cp-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-4);
  margin-top: 36rpx;
}

.cp-link {
  color: var(--brand-strong);
}

/* ---------- 进行中计时条 ---------- */
.cl-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(120deg, var(--brand-tint) 0%, var(--bg) 100%);
  border: 2rpx solid var(--peach-soft);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.cl-bar-sleep {
  background: linear-gradient(120deg, var(--sleep-soft) 0%, var(--info-soft) 100%);
  border-color: var(--sleep-line);
}

.cl-main {
  flex: 1;
  min-width: 0;
}

.cl-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.cl-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.cl-btn {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--card);
  background: var(--brand);
  border-radius: 999rpx;
  padding: 14rpx 30rpx;
}

.cl-bar-sleep .cl-btn {
  background: var(--sleep);
}

.cl-btn-line {
  color: var(--brand-strong);
  background: var(--card);
  border: 2rpx solid var(--brand-soft);
}
