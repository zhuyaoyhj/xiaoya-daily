.pp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(58, 46, 38, 0.45);
  display: flex;
  align-items: flex-end;
}

.pp-sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
}

.pp-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.pp-desc {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
  margin: 16rpx 0 32rpx;
}

.pp-link {
  color: var(--brand-strong);
}

.pp-actions {
  display: flex;
  gap: 20rpx;
}

.pp-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}

.pp-btn-ghost {
  background: var(--card);
  color: var(--text-3);
  border: 2rpx solid var(--line);
}

.pp-btn-primary {
  background: var(--brand);
  color: var(--on-brand);
}
