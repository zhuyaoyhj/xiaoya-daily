<view class="pp-mask" wx:if="{{show}}" catchtouchmove="noop">
  <view class="pp-sheet" catchtap="noop">
    <view class="pp-title">用之前想跟你说一声</view>
    <view class="pp-desc">
      这个功能需要用到你的剪贴板、位置或聊天文件。小芽日常的记录只存在你的手机上，不会上传。
      请先阅读 <text class="pp-link" bindtap="openContract">{{contractName}}</text>，同意后才能继续。
    </view>
    <view class="pp-actions">
      <button class="pp-btn pp-btn-ghost" bindtap="onDisagree">暂不使用</button>
      <button
        id="privacy-agree"
        class="pp-btn pp-btn-primary"
        open-type="agreePrivacyAuthorization"
        bindagreeprivacyauthorization="onAgree"
      >同意并继续</button>
    </view>
  </view>
</view>
