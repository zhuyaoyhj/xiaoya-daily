/* pages/meal-log/meal-log.wxss —— 记一餐 */

.top-tip {
  font-size: 24rpx;
  color: var(--text-4);
  padding: 8rpx 4rpx 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  margin-bottom: 18rpx;
}

.opt {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-4);
  margin-left: 8rpx;
}

/* ---------- 选项 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 4rpx;
}

/* ---------- 已选食材 ---------- */
.recipe-line {
  font-size: 22rpx;
  color: var(--text-4);
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  margin-bottom: 18rpx;
  line-height: 1.6;
}

.food-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.food-chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background: var(--brand-tint);
  border: 2rpx solid var(--brand-soft);
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 500;
}

.food-chip-alr {
  background: var(--warn-soft);
  border-color: var(--amber-soft);
  color: var(--warn);
}

.food-chip-x {
  margin-left: 12rpx;
  font-size: 26rpx;
  opacity: 0.55;
}

.empty-hint {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  padding: 16rpx 0;
}

/* ---------- 表单 ---------- */
.time-hint {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  padding: 12rpx 0 4rpx;
}

.note-area {
  width: 100%;
  min-height: 110rpx;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ---------- 按钮 ---------- */
.save-btn {
  margin-top: 8rpx;
}

.save-btn-off {
  opacity: 0.45;
}

.del-btn {
  margin-top: 20rpx;
  color: var(--danger);
}

/* ---------- 浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
}

.gtabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.gtab {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--card);
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.gtab-on {
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-color: var(--brand-soft);
  font-weight: 600;
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.food-item {
  width: calc((100% - 28rpx) / 3);
  min-height: 112rpx;
  padding: 18rpx 10rpx 16rpx;
  background: var(--sunken);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.15s;
}

.food-item-on {
  background: var(--brand-tint);
  border-color: var(--brand);
  box-shadow: 0 6rpx 16rpx rgba(240, 135, 107, 0.18);
}

.food-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.food-item-on .food-name {
  color: var(--brand-deep);
  font-weight: 600;
}

.food-meta {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.food-meta-bad {
  color: var(--warn);
}

.food-custom {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  font-size: 22rpx;
  color: var(--sleep-light);
  background: var(--sleep-soft);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-actions .btn {
  flex: 1;
}

/* ---------- 同上一餐 ---------- */
.same-last {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--brand-tint);
  border: 2rpx dashed var(--brand-soft);
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin: 8rpx 0 12rpx;
}

.same-last:active {
  opacity: 0.8;
}

.same-last-tag {
  flex: none;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--brand-strong);
}

.same-last-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.same-last-go {
  flex: none;
  font-size: 24rpx;
  color: var(--brand);
}
