/* pages/vaccine/vaccine.wxss */

.page-wrap-sticky {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

/* ---------- 顶部状态卡 ---------- */
.vax-hero {
  border-radius: 36rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(140deg, #FFF0E4 0%, #FFE2D2 100%);
  box-shadow: 0 14rpx 36rpx rgba(213, 176, 147, 0.18);
}

.vax-hero.tone-urgent {
  background: linear-gradient(140deg, #FFE9E4 0%, #FFD3C7 100%);
}

.vax-hero.tone-watch {
  background: linear-gradient(140deg, #F1EDFB 0%, #E3DCF5 100%);
}

.vax-hero.tone-due {
  background: linear-gradient(140deg, #FFF0E4 0%, #FFDFC9 100%);
}

.vax-hero.tone-soon {
  background: linear-gradient(140deg, #EFF6EE 0%, #DDEDDA 100%);
}

.vax-hero.tone-done {
  background: linear-gradient(140deg, #F6F3EE 0%, #ECE6DC 100%);
}

.vax-hero-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.vax-hero-face {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.vax-hero-id {
  flex: 1;
}

.vax-hero-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2E26;
}

.vax-hero-age {
  font-size: 22rpx;
  color: #8C7B6E;
  margin-top: 4rpx;
}

.vax-hero-chip {
  font-size: 20rpx;
  color: #B4614A;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

.vax-hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3A2E26;
  letter-spacing: -0.5rpx;
  line-height: 1.35;
}

.vax-hero-desc {
  font-size: 26rpx;
  color: #6B5A4D;
  margin-top: 12rpx;
  line-height: 1.6;
}

.vax-hero-meta {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed rgba(180, 140, 110, 0.28);
}

.vax-meta-item {
  font-size: 21rpx;
  color: #9A8574;
}

/* ---------- 通用小标题 ---------- */
.vax-sub {
  font-size: 22rpx;
  color: #9A8A7C;
  line-height: 1.6;
  margin: 6rpx 0 20rpx;
}

.vax-time {
  font-size: 21rpx;
  color: #B4614A;
  background: #FFF1E6;
  border-radius: 18rpx;
  padding: 6rpx 18rpx;
}

/* ---------- 待办事项 ---------- */
.task-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F7F1EA;
}

.task-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.task-when {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #B2886F;
  padding-top: 4rpx;
}

.task-body {
  flex: 1;
}

.task-text {
  font-size: 27rpx;
  color: #3A2E26;
  line-height: 1.6;
}

.task-tag {
  display: inline-block;
  font-size: 18rpx;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  margin-top: 8rpx;
}

.tag-must {
  background: #FFEDE6;
  color: #D9603F;
}

.tag-warn {
  background: #FFE7E3;
  color: #C43C2A;
}

.tag-watch {
  background: #EFEAFB;
  color: #6F5BA6;
}

.tag-care {
  background: #EFF5EE;
  color: #4F7A4A;
}

.tag-prep {
  background: #F3F1EC;
  color: #8C7B6E;
}

/* ---------- 反应 ---------- */
.react-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F7F1EA;
}

.react-row:last-child {
  border-bottom: none;
}

.react-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #F0A05B;
  margin: 14rpx 18rpx 0 4rpx;
  flex-shrink: 0;
}

.react-soon-when {
  width: 104rpx;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #7A6AA8;
  padding-top: 6rpx;
}

.react-body {
  flex: 1;
}

.react-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #3A2E26;
  line-height: 1.5;
}

.react-tip {
  font-size: 22rpx;
  color: #8C7B6E;
  margin-top: 4rpx;
  line-height: 1.6;
}

.react-now {
  font-size: 18rpx;
  color: #C9694A;
  background: #FFF1E6;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.react-soon-head {
  font-size: 21rpx;
  color: #9A8A7C;
  margin-bottom: 4rpx;
}

/* ---------- 就医警示 ---------- */
.danger-card {
  background: #FFFBFA;
  border: 2rpx solid #FBE0D9;
}

.danger-title {
  color: #C4432B;
}

.flag-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.flag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #E0704F;
  margin: 14rpx 16rpx 0 2rpx;
  flex-shrink: 0;
}

.flag-text {
  flex: 1;
  font-size: 25rpx;
  color: #6B4238;
  line-height: 1.6;
}

.danger-note {
  font-size: 21rpx;
  color: #A8604C;
  background: #FFF0EC;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* ---------- 观察期已过 ---------- */
.calm-card {
  background: #F7F5F0;
  box-shadow: none;
}

.calm-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B5A4D;
}

.calm-desc {
  font-size: 24rpx;
  color: #8C7B6E;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* ---------- 规划表脚注 ---------- */
.plan-foot {
  font-size: 20rpx;
  color: #A99A8C;
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ---------- 待安排疫苗 ---------- */
.wait-card {
  background: linear-gradient(140deg, #FFFFFF 0%, #FBF6FD 100%);
}

.wait-count {
  font-size: 21rpx;
  color: #7A6AA8;
  background: #F0EBFA;
  border-radius: 18rpx;
  padding: 6rpx 18rpx;
}

.wait-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F7F1EA;
}

.wait-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.wait-date {
  width: 84rpx;
  flex-shrink: 0;
  text-align: center;
  background: #F5F0FB;
  border-radius: 18rpx;
  padding: 8rpx 0;
  margin-right: 18rpx;
}

.wait-day {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #7A6AA8;
  line-height: 1.2;
}

.wait-month {
  display: block;
  font-size: 18rpx;
  color: #9A8AA8;
  margin-top: 2rpx;
}

.wait-body {
  flex: 1;
  min-width: 0;
}

.wait-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #3A2E26;
  line-height: 1.5;
}

.wait-sub {
  font-size: 21rpx;
  color: #9A8A7C;
  margin-top: 4rpx;
}

.wait-arrow {
  font-size: 32rpx;
  color: #D8C7B8;
  margin-left: 12rpx;
}

/* ---------- 记录列表 ---------- */
.rec-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F7F1EA;
}

.rec-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #3A2E26;
  line-height: 1.5;
}

.rec-sub {
  font-size: 21rpx;
  color: #9A8A7C;
  margin-top: 4rpx;
}

.rec-note {
  font-size: 21rpx;
  color: #B2886F;
  background: #FBF7F2;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.rec-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.rec-cat {
  font-size: 18rpx;
  color: #6E8F62;
  background: #EFF5EE;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
}

.rec-cat-paid {
  color: #7A6AA8;
  background: #F0EBFA;
}

.rec-status {
  font-size: 19rpx;
  color: #A99A8C;
  margin-top: 8rpx;
}

.rec-status-on {
  color: #C9694A;
}

.rec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid #F7F1EA;
  margin-top: 18rpx;
  padding-top: 16rpx;
}

.rec-foot-text {
  font-size: 20rpx;
  color: #A99A8C;
}

.rec-toggle {
  font-size: 21rpx;
  color: #C9694A;
}

/* ---------- 免疫规划表 ---------- */
.plan-toggle {
  font-size: 22rpx;
  color: #B2886F;
}

.plan-list-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #F9F5F0;
}

.plan-list-row:last-child {
  border-bottom: none;
}

.plan-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E4D7C9;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.plan-dot.done {
  background: #8FBF84;
}

.plan-dot.soon {
  background: #E8B96A;
}

.plan-list-name {
  flex: 1;
  font-size: 24rpx;
  color: #4A3C32;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.plan-list-dose {
  font-size: 20rpx;
  color: #A99A8C;
  width: 100rpx;
  flex-shrink: 0;
}

.plan-list-month {
  font-size: 20rpx;
  color: #A99A8C;
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
}

.plan-list-status {
  width: 130rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 19rpx;
}

.status-done {
  color: #6E8F62;
}

.status-covered {
  color: #7A6AA8;
}

.status-hidden {
  color: #BCAFA3;
}

.status-due,
.status-overdue {
  color: #C9694A;
}

.status-soon {
  color: #B98A3E;
}

.status-later {
  color: #BCAFA3;
}

.plan-list-covered .plan-list-name {
  color: #8C7B6E;
}

/* ---------- 已移除的规划项 ---------- */
.removed-head {
  font-size: 21rpx;
  color: #A99A8C;
  padding: 20rpx 0 8rpx;
  border-top: 2rpx dashed #F0E6DA;
  margin-top: 8rpx;
}

.removed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.removed-name {
  flex: 1;
  font-size: 22rpx;
  color: #A99A8C;
  text-decoration: line-through;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.removed-restore {
  font-size: 21rpx;
  color: #C9694A;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ---------- 空态 ---------- */
.empty-desc {
  margin: 12rpx 0 28rpx;
  line-height: 1.6;
}

.empty-btn {
  display: inline-flex;
}

/* ---------- 底部固定按钮 ---------- */
.sticky-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 248, 240, 0) 0%, #FFF8F0 32%);
}
