/* pages/vaccine/vaccine.wxss */

.page-wrap-sticky {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

/* ---------- 顶部状态卡 ---------- */
.vax-hero {
  border-radius: 36rpx;
  padding: 36rpx 32rpx 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--peach-soft) 100%);
  box-shadow: 0 14rpx 36rpx var(--shadow-strong);
}

.vax-hero.tone-urgent {
  background: linear-gradient(140deg, var(--danger-soft) 0%, var(--peach-soft) 100%);
}

.vax-hero.tone-watch {
  background: linear-gradient(140deg, var(--sleep-soft) 0%, var(--sleep-line) 100%);
}

.vax-hero.tone-due {
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--peach-soft) 100%);
}

.vax-hero.tone-soon {
  background: linear-gradient(140deg, var(--ok-soft) 0%, var(--ok-soft) 100%);
}

.vax-hero.tone-done {
  background: linear-gradient(140deg, var(--sunken) 0%, var(--line) 100%);
}

.vax-hero-top {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.vax-hero-face {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--glass-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.vax-hero-id {
  flex: 1;
}

.vax-hero-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.vax-hero-age {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.vax-hero-chip {
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--glass-strong);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
}

.vax-hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.5rpx;
  line-height: 1.35;
}

.vax-hero-desc {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 12rpx;
  line-height: 1.6;
}

.vax-hero-meta {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed rgba(180, 140, 110, 0.28);
}

.vax-meta-item {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------- 通用小标题 ---------- */
.vax-sub {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  margin: 6rpx 0 20rpx;
}

.vax-time {
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-radius: 18rpx;
  padding: 6rpx 18rpx;
}

/* ---------- 待办事项 ---------- */
.task-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 2rpx solid var(--sunken);
}

.task-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.task-when {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-warm);
  padding-top: 4rpx;
}

.task-body {
  flex: 1;
}

.task-text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

.task-tag {
  display: inline-block;
  font-size: 22rpx;
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  margin-top: 8rpx;
}

.tag-must {
  background: var(--danger-soft);
  color: var(--brand-strong);
}

.tag-warn {
  background: var(--danger-soft);
  color: var(--danger);
}

.tag-watch {
  background: var(--sleep-soft);
  color: var(--sleep);
}

.tag-care {
  background: var(--ok-soft);
  color: var(--ok);
}

.tag-prep {
  background: var(--sunken);
  color: var(--text-3);
}

/* ---------- 反应 ---------- */
.react-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--sunken);
}

.react-row:last-child {
  border-bottom: none;
}

.react-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--apricot);
  margin: 14rpx 18rpx 0 4rpx;
  flex-shrink: 0;
}

.react-soon-when {
  width: 104rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--sleep);
  padding-top: 6rpx;
}

.react-body {
  flex: 1;
}

.react-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}

.react-tip {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  line-height: 1.6;
}

.react-now {
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.react-soon-head {
  font-size: 22rpx;
  color: var(--text-4);
  margin-bottom: 4rpx;
}

/* ---------- 就医警示 ---------- */
.danger-card {
  background: var(--card);
  border: 2rpx solid var(--danger-soft);
}

.danger-title {
  color: var(--danger);
}

.flag-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.flag-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-strong);
  margin: 14rpx 16rpx 0 2rpx;
  flex-shrink: 0;
}

.flag-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--cocoa);
  line-height: 1.6;
}

.danger-note {
  font-size: 22rpx;
  color: var(--cocoa);
  background: var(--danger-soft);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 16rpx;
  line-height: 1.6;
}

/* ---------- 观察期已过 ---------- */
.calm-card {
  background: var(--sunken);
  box-shadow: none;
}

.calm-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
}

.calm-desc {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 8rpx;
  line-height: 1.6;
}

/* ---------- 规划表脚注 ---------- */
.plan-foot {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  margin-top: 16rpx;
}

/* ---------- 待安排疫苗 ---------- */
.wait-card {
  background: linear-gradient(140deg, var(--card) 0%, var(--info-soft) 100%);
}

.wait-count {
  font-size: 22rpx;
  color: var(--sleep);
  background: var(--sleep-soft);
  border-radius: 18rpx;
  padding: 6rpx 18rpx;
}

.wait-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--sunken);
}

.wait-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.wait-date {
  width: 84rpx;
  flex-shrink: 0;
  text-align: center;
  background: var(--sleep-soft);
  border-radius: 18rpx;
  padding: 8rpx 0;
  margin-right: 18rpx;
}

.wait-day {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--sleep);
  line-height: 1.2;
}

.wait-month {
  display: block;
  font-size: 22rpx;
  color: var(--sleep-muted);
  margin-top: 2rpx;
}

.wait-body {
  flex: 1;
  min-width: 0;
}

.wait-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}

.wait-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.wait-arrow {
  font-size: 32rpx;
  color: var(--line-strong);
  margin-left: 12rpx;
}

/* ---------- 记录列表 ---------- */
.rec-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--sunken);
}

.rec-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}

.rec-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.rec-note {
  font-size: 22rpx;
  color: var(--text-warm);
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  margin-top: 8rpx;
  display: inline-block;
}

.rec-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.rec-cat {
  font-size: 22rpx;
  color: var(--leaf);
  background: var(--ok-soft);
  border-radius: 12rpx;
  padding: 2rpx 12rpx;
}

.rec-cat-paid {
  color: var(--sleep);
  background: var(--sleep-soft);
}

.rec-status {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.rec-status-on {
  color: var(--brand-deep);
}

.rec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 2rpx solid var(--sunken);
  margin-top: 18rpx;
  padding-top: 16rpx;
}

.rec-foot-text {
  font-size: 22rpx;
  color: var(--text-4);
}

.rec-toggle {
  font-size: 22rpx;
  color: var(--brand-deep);
}

/* ---------- 免疫规划表 ---------- */
.plan-toggle {
  font-size: 22rpx;
  color: var(--text-warm);
}

.plan-list-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 2rpx solid var(--sunken);
}

.plan-list-row:last-child {
  border-bottom: none;
}

.plan-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--line-strong);
  margin-right: 14rpx;
  flex-shrink: 0;
}

.plan-dot.done {
  background: var(--leaf-light);
}

.plan-dot.soon {
  background: var(--warn-strong);
}

.plan-list-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.plan-list-dose {
  font-size: 22rpx;
  color: var(--text-4);
  width: 100rpx;
  flex-shrink: 0;
}

.plan-list-month {
  font-size: 22rpx;
  color: var(--text-4);
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
}

.plan-list-status {
  width: 130rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
}

.status-done {
  color: var(--leaf);
}

.status-covered {
  color: var(--sleep);
}

.status-hidden {
  color: var(--text-5);
}

.status-due,
.status-overdue {
  color: var(--brand-deep);
}

.status-soon {
  color: var(--warn);
}

.status-later {
  color: var(--text-5);
}

.plan-list-covered .plan-list-name {
  color: var(--text-3);
}

/* ---------- 已移除的规划项 ---------- */
.removed-head {
  font-size: 22rpx;
  color: var(--text-4);
  padding: 20rpx 0 8rpx;
  border-top: 2rpx dashed var(--line);
  margin-top: 8rpx;
}

.removed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.removed-name {
  flex: 1;
  font-size: 22rpx;
  color: var(--text-4);
  text-decoration: line-through;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.removed-restore {
  font-size: 22rpx;
  color: var(--brand-deep);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ---------- 空态 ---------- */
.empty-desc {
  margin: 12rpx 0 28rpx;
  line-height: 1.6;
}

.empty-btn {
  display: inline-flex;
}

/* ---------- 底部固定按钮 ---------- */
.sticky-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 248, 240, 0) 0%, var(--bg) 32%);
}
