<import src="/components/care-panel/care-panel.wxml" />
<view class="page-wrap">

  <!-- 顶部问候 + 宝宝档案 -->
  <view class="hero">
    <view class="hero-blob hero-blob-a"></view>
    <view class="hero-blob hero-blob-b"></view>

    <view class="hero-top">
      <view>
        <view class="hero-hi">{{greeting}}</view>
        <view class="hero-date">{{dateText}}</view>
      </view>
      <view class="hero-pill" wx:if="{{babies.length > 1}}" bindtap="goBabies">切换宝宝</view>
    </view>

    <view class="baby-row" wx:if="{{baby}}">
      <view class="baby-avatar">{{baby.avatar}}</view>
      <view class="baby-main">
        <view class="baby-name">
          {{baby.name}}
          <text class="baby-gender">{{baby.genderText}}</text>
        </view>
        <view class="baby-age">{{baby.ageText}}</view>
        <view class="baby-meta">{{baby.metaText}}</view>
      </view>
      <view class="baby-edit" catchtap="goEditBaby">编辑</view>
    </view>

    <view class="baby-empty" wx:else bindtap="goAddBaby">
      <view class="baby-empty-emoji">🍼</view>
      <view class="baby-empty-title">先添加宝宝</view>
      <view class="baby-empty-desc">填好出生日期，就能按月龄拿到吃、动、学、睡建议</view>
      <view class="baby-empty-btn">添加宝宝信息</view>
    </view>
  </view>

  <block wx:if="{{baby}}">
    <!-- 进行中的计时：正在喂 / 正在睡 -->
    <template is="care-live" data="{{careActive}}" />

    <!-- 照护状态：距上次喂奶多久、睡了多久、今天几片尿布 -->
    <view class="card care-card">
      <view class="care-alert" wx:if="{{careAlert}}" bindtap="goRecord">⚠️ {{careAlert.text}}</view>
      <view class="care-line" wx:for="{{careLines}}" wx:key="key" bindtap="goRecord">
        <text class="care-emoji">{{item.emoji}}</text>
        <view class="care-main">
          <view class="care-text {{item.empty ? 'care-text-empty' : ''}} {{item.live ? 'care-text-live' : ''}}">{{item.text}}</view>
          <view class="care-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        </view>
      </view>
      <view class="care-actions">
        <view class="care-act {{careActive.feed ? 'care-act-on' : ''}}" data-type="feed" bindtap="openCarePanel">
          <view class="care-act-emoji">🍼</view>
          <view class="care-act-text">{{careActive.feed ? '结束喂奶' : '喂奶'}}</view>
        </view>
        <view class="care-act {{careActive.sleep ? 'care-act-on care-act-sleep' : ''}}" data-type="sleep" bindtap="openCarePanel">
          <view class="care-act-emoji">{{careActive.sleep ? '☀️' : '😴'}}</view>
          <view class="care-act-text">{{careActive.sleep ? '醒了' : '睡觉'}}</view>
        </view>
        <view class="care-act" data-type="diaper" bindtap="openCarePanel">
          <view class="care-act-emoji">🧷</view>
          <view class="care-act-text">换尿布</view>
        </view>
        <view class="care-act" bindtap="goRecord">
          <view class="care-act-emoji">📋</view>
          <view class="care-act-text">全部记录</view>
        </view>
      </view>
    </view>

    <!-- 疫苗到期提醒：7 天内到期 / 已过建议日期，点一下直接记接种 -->
    <view class="vax-remind {{vaxRemind.overdue ? 'vax-remind-over' : ''}}" wx:if="{{vaxRemind}}" bindtap="goVaxRemind">
      <text class="vax-remind-emoji">💉</text>
      <view class="vax-remind-main">
        <view class="vax-remind-text">{{vaxRemind.text}}</view>
        <view class="vax-remind-sub">{{vaxRemind.more > 0 ? '另有 ' + vaxRemind.more + ' 针也快到了 · ' : ''}}打完点这里记一下</view>
      </view>
      <view class="vax-remind-go">记接种 ›</view>
    </view>

    <!-- 一键记一餐：按当前餐次推荐，点一下就进预填好的记录页（6 月龄起） -->
    <view class="suggest-bar" wx:if="{{suggest && !suggest.logged}}" bindtap="quickMeal">
      <text class="suggest-emoji">{{suggest.emoji}}</text>
      <view class="suggest-main">
        <view class="suggest-slot">{{suggest.slotLabel}}吃了吗？</view>
        <view class="suggest-name">推荐：{{suggest.name}}</view>
      </view>
      <view class="suggest-cta">记一下</view>
    </view>

    <!-- 其他入口：按月龄换内容（喂奶/睡/尿布在照护卡、记一餐在上面的推荐条，不重复） -->
    <view class="quick-log">
      <view
        class="quick-log-item"
        wx:for="{{quickItems}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onQuick"
      >
        <view class="quick-log-emoji">{{item.emoji}}</view>
        <view class="quick-log-text">{{item.text}}</view>
      </view>
    </view>

    <view class="card recent-card" wx:if="{{recent.length > 0}}">
      <view class="recent-head">
        <text class="recent-title">最近记的</text>
      </view>
      <view
        class="recent-item"
        wx:for="{{recent}}"
        wx:key="id"
        data-kind="{{item.kind}}"
        data-rid="{{item.rid}}"
        bindtap="openRecord"
      >
        <text class="recent-emoji">{{item.emoji}}</text>
        <view class="recent-main">
          <view class="recent-name">{{item.title}}</view>
          <view class="recent-desc">{{item.desc}}</view>
        </view>
        <text class="recent-when">{{item.when}}</text>
      </view>
    </view>

    <!-- 今日重点 -->
    <view class="section-head">
      <view class="section-title">今日重点</view>
      <view class="section-more" bindtap="goGuide">{{ageLabel}} ›</view>
    </view>

    <view class="tip-grid">
      <view
        class="tip-card"
        wx:for="{{tips}}"
        wx:key="key"
        data-tab="{{item.key}}"
        bindtap="goGuide"
      >
        <view class="tip-badge" style="background:{{item.soft}};color:{{item.color}}">
          <text class="tip-emoji">{{item.emoji}}</text>
          <text>{{item.title}}</text>
        </view>
        <view class="tip-heading">{{item.heading}}</view>
        <view class="tip-summary">{{item.summary}}</view>
      </view>
    </view>

    <!-- 天气与穿衣 -->
    <view class="section-head">
      <view class="section-title">今天穿什么</view>
      <view class="section-more" bindtap="goWeather">天气详情 ›</view>
    </view>

    <view class="card weather-card" wx:if="{{weatherState === 'ok'}}" bindtap="goWeather">
      <view class="weather-top">
        <view class="weather-temp-box">
          <text class="weather-icon">{{weather.icon}}</text>
          <text class="weather-temp">{{weather.temp}}°</text>
        </view>
        <view class="weather-meta">
          <view class="weather-city">{{weather.label}}</view>
          <view class="tiny">{{weather.text}} · {{weather.min}}° ~ {{weather.max}}°</view>
        </view>
        <view class="weather-level">{{care.level}}</view>
      </view>

      <view class="divider-dashed"></view>

      <view class="weather-advice">{{care.headline}}</view>
      <view class="weather-alert" wx:if="{{care.alerts.length > 0}}">{{care.alerts[0]}}</view>
      <view class="weather-more">{{manualTemp ? '按你填的温度估算' : weather.full}} · 查看完整建议</view>
    </view>

    <view class="card weather-card weather-empty" wx:elif="{{weatherState === 'no-place'}}">
      <view class="weather-empty-title">还没设置地点</view>
      <view class="muted">设好地点，天气会自动更新；也可以直接填今天的温度</view>
      <view class="weather-empty-actions">
        <view class="btn btn-ghost btn-sm" bindtap="goPlace">设置地点</view>
        <view class="btn btn-line btn-sm" bindtap="goManualTemp">直接填温度</view>
      </view>
    </view>

    <view class="card weather-card weather-empty" wx:elif="{{weatherState === 'loading'}}">
      <view class="weather-empty-title">正在获取天气…</view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line skeleton-short"></view>
    </view>

    <view class="card weather-card weather-empty" wx:else>
      <view class="weather-empty-title">天气暂时取不到</view>
      <view class="muted">不影响穿衣建议：填一下今天大概几度，照样能算</view>
      <view class="weather-empty-actions">
        <view class="btn btn-ghost btn-sm" bindtap="goManualTemp">填温度</view>
        <view class="btn btn-line btn-sm" bindtap="retryWeather">重新获取</view>
      </view>
    </view>

    <!-- 疫苗护理（顶部已有到期提醒时不重复展示） -->
    <block wx:if="{{!vaxRemind}}">
    <view class="section-head">
      <view class="section-title">疫苗护理</view>
      <view class="section-more" bindtap="goVaccine">记录与提醒 ›</view>
    </view>

    <view class="card vax-card vax-tone-{{vax.tone}}" bindtap="goVaccine">
      <view class="vax-card-emoji">{{vax.emoji}}</view>
      <view class="vax-card-body">
        <view class="vax-card-title">{{vax.title}}</view>
        <view class="vax-card-desc">{{vax.desc}}</view>
      </view>
      <view class="vax-card-arrow">›</view>
    </view>
    </block>

    <!-- 推送给带娃人：订阅模板配好后才展开成完整卡片；之前只留一行「发给家人」 -->
    <view class="push-line" wx:if="{{!tmplConfigured}}" bindtap="goShare">
      <text class="push-line-emoji">👨‍👩‍👧</text>
      <text class="push-line-text">把今天的建议做成卡片，发给家人</text>
      <text class="push-line-go">›</text>
    </view>
    <view class="card push-card" wx:else>
      <view class="push-title">推送给一起带娃的人</view>
      <view class="push-desc">生成一张今日卡片，转发到家庭群或指定的人。吃、动、学、睡和穿衣，一屏讲清楚。</view>
      <view class="push-targets" wx:if="{{targetNames}}">
        <text class="chip">已选：{{targetNames}}</text>
      </view>
      <view class="push-targets" wx:else>
        <text class="chip chip-plain" bindtap="goFamily">还没选推送对象，点这里添加</text>
      </view>
      <button class="btn btn-primary btn-block push-btn" bindtap="goShare">生成今日卡片</button>
    </view>

    <disclaimer />
  </block>

  <block wx:else>
    <view class="card flat-tip">
      <view class="h3">这个小程序能做什么</view>
      <view class="flat-tip-item">1 · 按月龄给出「吃、动、学、睡」的具体建议</view>
      <view class="flat-tip-item">2 · 接入实时天气，算出今天该穿几层、睡袋用多少 TOG</view>
      <view class="flat-tip-item">3 · 一键生成卡片，转发给家人或一起带娃的阿姨</view>
    </view>
    <disclaimer />
  </block>

  <template is="care-panel" data="{{carePanel, careBottleMl, careBottleTypes, careBottleType, careBottleInput, careDiaperKinds, carePoopColors, carePoopTextures, carePendingDiaper}}" />
</view>
