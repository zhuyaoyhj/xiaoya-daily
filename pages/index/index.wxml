<import src="/components/care-panel/care-panel.wxml" />
<view class="page-wrap">

  <!-- 顶部问候 + 宝宝档案 -->
  <view class="hero">
    <view class="hero-blob hero-blob-a"></view>
    <view class="hero-blob hero-blob-b"></view>

    <view class="hero-top">
      <view>
        <view class="hero-hi">{{greeting}}</view>
        <view class="hero-date">{{dateText}}</view>
      </view>
      <view class="hero-pill" wx:if="{{babies.length > 1}}" bindtap="goBabies">切换宝宝</view>
    </view>

    <view class="baby-row" wx:if="{{baby}}">
      <view class="baby-avatar">{{baby.avatar}}</view>
      <view class="baby-main">
        <view class="baby-name">
          {{baby.name}}
          <text class="baby-gender">{{baby.genderText}}</text>
        </view>
        <view class="baby-age">{{baby.ageText}}</view>
        <view class="baby-meta">{{baby.metaText}}</view>
      </view>
      <view class="baby-edit" catchtap="goEditBaby">编辑</view>
    </view>

    <view class="baby-empty" wx:else bindtap="goAddBaby">
      <view class="baby-empty-emoji">🍼</view>
      <view class="baby-empty-title">先添加宝宝</view>
      <view class="baby-empty-desc">填好出生日期，就能按月龄拿到吃、动、学、睡建议</view>
      <view class="baby-empty-btn">添加宝宝信息</view>
    </view>
  </view>

  <block wx:if="{{baby}}">
    <!-- ① 提醒位：同一时间只出一条，按紧急程度：首次引导 > 疫苗到期 > 备份 -->
    <view class="onboard" wx:if="{{onboard}}">
      <view class="onboard-main">
        <view class="onboard-text">👋 {{onboard.text}}</view>
        <view class="onboard-sub">{{onboard.sub}}</view>
      </view>
      <view class="onboard-acts">
        <view class="onboard-btn" wx:if="{{onboard.action}}" bindtap="onboardAction">{{onboard.action}}</view>
        <view class="onboard-skip" bindtap="onboardSkip">{{onboard.step === 'place' ? '填温度' : '知道了'}}</view>
      </view>
    </view>
    <view class="vax-remind {{vaxRemind.overdue ? 'vax-remind-over' : ''}}" wx:elif="{{vaxRemind}}" bindtap="goVaxRemind">
      <text class="vax-remind-emoji">💉</text>
      <view class="vax-remind-main">
        <view class="vax-remind-text">{{vaxRemind.text}}</view>
        <view class="vax-remind-sub">{{vaxRemind.more > 0 ? '另有 ' + vaxRemind.more + ' 针也快到了 · ' : ''}}打完点这里记一下</view>
      </view>
      <view class="vax-remind-go">记接种 ›</view>
    </view>
    <view class="backup-remind" wx:elif="{{backupRemind}}">
      <text class="backup-remind-emoji">💾</text>
      <view class="backup-remind-main" bindtap="goBackupNow">
        <view class="backup-remind-text">{{backupRemind.text}}</view>
        <view class="backup-remind-go">去备份 ›</view>
      </view>
      <view class="backup-remind-x" bindtap="dismissBackup">×</view>
    </view>

    <!-- ② 照护：进行中的计时 + 距上次喂奶 / 睡眠 / 尿布 + 三个大按钮 -->
    <template is="care-live" data="{{careActive}}" />
    <view class="card care-card">
      <view class="care-alert" wx:if="{{careAlert}}" bindtap="goRecord">⚠️ {{careAlert.text}}</view>
      <view class="care-line" wx:for="{{careLines}}" wx:key="key" bindtap="goRecord">
        <text class="care-emoji">{{item.emoji}}</text>
        <view class="care-main">
          <view class="care-text {{item.empty ? 'care-text-empty' : ''}} {{item.live ? 'care-text-live' : ''}}">{{item.text}}</view>
          <view class="care-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        </view>
      </view>
      <view class="care-actions">
        <view class="care-act {{careActive.feed ? 'care-act-on' : ''}}" data-type="feed" bindtap="openCarePanel">
          <view class="care-act-emoji">🍼</view>
          <view class="care-act-text">{{careActive.feed ? '结束喂奶' : '喂奶'}}</view>
        </view>
        <view class="care-act {{careActive.sleep ? 'care-act-on care-act-sleep' : ''}}" data-type="sleep" bindtap="openCarePanel">
          <view class="care-act-emoji">{{careActive.sleep ? '☀️' : '😴'}}</view>
          <view class="care-act-text">{{careActive.sleep ? '醒了' : '睡觉'}}</view>
        </view>
        <view class="care-act" data-type="diaper" bindtap="openCarePanel">
          <view class="care-act-emoji">🧷</view>
          <view class="care-act-text">换尿布</view>
        </view>
      </view>
    </view>

    <!-- ③ 记一笔：一键记餐（6 月龄起）+ 按月龄的其他入口 + 最近两条，合成一张卡 -->
    <view class="card log-card">
      <view class="suggest-bar" wx:if="{{suggest && !suggest.logged}}" bindtap="quickMeal">
        <text class="suggest-emoji">{{suggest.emoji}}</text>
        <view class="suggest-main">
          <view class="suggest-slot">{{suggest.slotLabel}}吃了吗？</view>
          <view class="suggest-name">推荐：{{suggest.name}}</view>
        </view>
        <view class="suggest-cta">记一下</view>
      </view>
      <view class="quick-log">
        <view
          class="quick-log-item"
          wx:for="{{quickItems}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onQuick"
        >
          <view class="quick-log-emoji">{{item.emoji}}</view>
          <view class="quick-log-text">{{item.text}}</view>
        </view>
      </view>
      <block wx:if="{{recent.length > 0}}">
        <view class="recent-head">
          <text class="recent-title">最近记的</text>
          <text class="recent-more" bindtap="goRecord">全部记录 ›</text>
        </view>
        <view
          class="recent-item"
          wx:for="{{recent}}"
          wx:key="key"
          data-open="{{item.open}}"
          bindtap="openRecord"
        >
          <text class="recent-emoji">{{item.emoji}}</text>
          <view class="recent-main">
            <view class="recent-name">{{item.title}}</view>
            <view class="recent-desc" wx:if="{{item.detail || item.by}}">{{item.detail}}{{item.by ? (item.detail ? ' · ' : '') + item.by + '记' : ''}}</view>
          </view>
          <text class="recent-when">{{item.when}}</text>
        </view>
      </block>
      <view class="recent-more recent-more-solo" wx:else bindtap="goRecord">全部记录 ›</view>
    </view>

    <!-- ④ 今日重点：吃、动、学、睡 -->
    <view class="section-head">
      <view class="section-title">今日重点</view>
      <view class="section-more" bindtap="goGuide">{{ageLabel}} ›</view>
    </view>
    <view class="tip-grid">
      <view
        class="tip-card"
        wx:for="{{tips}}"
        wx:key="key"
        data-tab="{{item.key}}"
        bindtap="goGuide"
      >
        <view class="tip-badge" style="background:{{item.soft}};color:{{item.color}}">
          <text class="tip-emoji">{{item.emoji}}</text>
          <text>{{item.title}}</text>
        </view>
        <view class="tip-heading">{{item.heading}}</view>
        <view class="tip-summary">{{item.summary}}</view>
      </view>
    </view>

    <!-- ⑤ 今天：穿衣一行 + 疫苗一行（顶部已有到期提醒时疫苗这行不重复） -->
    <view class="card today-card">
      <view class="today-row" wx:if="{{weatherState === 'ok'}}" bindtap="goWeather">
        <text class="today-emoji">{{weather.icon}}</text>
        <view class="today-main">
          <view class="today-title">{{weather.temp}}° · {{care.headline}}</view>
          <view class="today-sub">{{care.alerts.length > 0 ? care.alerts[0] : (manualTemp ? '按你填的温度估算' : weather.label + ' · ' + weather.text)}}</view>
        </view>
        <view class="row-arrow"></view>
      </view>
      <view class="today-row" wx:elif="{{weatherState === 'loading'}}">
        <text class="today-emoji">🌤</text>
        <view class="today-main">
          <view class="today-title">正在获取天气…</view>
          <view class="skeleton-line skeleton-short"></view>
        </view>
      </view>
      <view class="today-row" wx:else>
        <text class="today-emoji">🧥</text>
        <view class="today-main">
          <view class="today-title">{{weatherState === 'no-place' ? '还没设置地点' : '天气暂时取不到'}}</view>
          <view class="today-sub">填一下今天大概几度，照样算出穿几层</view>
        </view>
        <view class="today-btn" bindtap="goManualTemp">填温度</view>
        <view class="today-btn today-btn-line" wx:if="{{weatherState === 'no-place'}}" bindtap="goPlace">设地点</view>
        <view class="today-btn today-btn-line" wx:else bindtap="retryWeather">重试</view>
      </view>

      <view class="today-row" wx:if="{{!vaxRemind}}" bindtap="goVaccine">
        <text class="today-emoji">{{vax.emoji}}</text>
        <view class="today-main">
          <view class="today-title {{vax.tone === 'urgent' ? 'today-title-warn' : ''}}">{{vax.title}}</view>
          <view class="today-sub">{{vax.desc}}</view>
        </view>
        <view class="row-arrow"></view>
      </view>
    </view>

    <!-- ⑥ 发给家人：订阅模板配好前只是「做卡片转发」；配好后显示每天推给谁 -->
    <view class="push-line" wx:if="{{!tmplConfigured}}" bindtap="goShare">
      <text class="push-line-emoji">👨‍👩‍👧</text>
      <text class="push-line-text">把今天的建议做成卡片，发给家人</text>
      <view class="row-arrow"></view>
    </view>
    <view class="push-line" wx:else bindtap="goPush">
      <text class="push-line-emoji">📮</text>
      <text class="push-line-text">{{targetNames ? '每天推送给：' + targetNames : '每天推送给家人 · 还没选人，点这里添加'}}</text>
      <view class="row-arrow"></view>
    </view>

    <disclaimer />
  </block>

  <block wx:else>
    <!-- 还没宝宝：先让人看到「记起来是什么样」，比三行说明更有说服力 -->
    <view class="demo-label">— 添加宝宝后，首页大概是这样 —</view>
    <view class="card demo-card" bindtap="goAddBaby">
      <view class="demo-line"><text class="demo-line-emoji">🍼</text>上次喂奶 2小时15分前<text class="demo-line-sub">右侧 15 分</text></view>
      <view class="demo-line"><text class="demo-line-emoji">😴</text>正在睡 · 已睡 48 分钟</view>
      <view class="demo-line"><text class="demo-line-emoji">🧷</text>今天 6 片（尿 5 · 便 1）</view>
      <view class="demo-line"><text class="demo-line-emoji">💉</text>3 天后该打 百白破 第二剂</view>
      <view class="demo-line"><text class="demo-line-emoji">🧥</text>今天 18℃：穿两层，睡袋 1.0 TOG</view>
    </view>
    <view class="card flat-tip">
      <view class="h3">一家人一起记</view>
      <view class="flat-tip-item">喂奶计时、睡觉、换尿布，两下点完</view>
      <view class="flat-tip-item">按月龄给「吃、动、学、睡」建议，早产宝宝按矫正月龄</view>
      <view class="flat-tip-item">身高体重对照生长曲线，每周一份小结发家庭群</view>
    </view>
    <view class="btn btn-primary btn-block" bindtap="goAddBaby">添加宝宝，开始记录</view>
    <disclaimer />
  </block>

  <template is="care-panel" data="{{carePanel, careBottleMl, careBottleTypes, careBottleType, careBottleInput, careDiaperKinds, carePoopColors, carePoopTextures, carePendingDiaper}}" />
  <privacy-popup />
</view>
