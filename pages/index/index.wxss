@import "/components/care-panel/care-panel.wxss";

/* pages/index/index.wxss */

/* ---------- 顶部 ---------- */
.hero {
  position: relative;
  margin: 24rpx 0 36rpx;
  padding: 36rpx 32rpx 34rpx;
  border-radius: 44rpx;
  background: linear-gradient(150deg, var(--brand-tint) 0%, var(--peach-soft) 62%, var(--peach-soft) 100%);
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx var(--shadow-strong);
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
}

.hero-blob-a {
  width: 340rpx;
  height: 340rpx;
  background: var(--glass);
  top: -160rpx;
  right: -100rpx;
}

.hero-blob-b {
  width: 220rpx;
  height: 220rpx;
  background: var(--glass);
  bottom: -130rpx;
  left: -70rpx;
}

.hero-top {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.hero-hi {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--shade);
  letter-spacing: 0.5rpx;
}

.hero-date {
  font-size: 24rpx;
  color: var(--text-warm);
  margin-top: 8rpx;
}

.hero-pill {
  position: relative;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  background: var(--glass-strong);
  color: var(--brand-deep);
  font-size: 24rpx;
  line-height: 56rpx;
}

/* ---------- 宝宝卡 ---------- */
.baby-row {
  position: relative;
  display: flex;
  align-items: center;
  background: var(--glass-strong);
  border-radius: 32rpx;
  padding: 26rpx 24rpx;
}

.baby-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 3rpx var(--glass-strong);
}

.baby-main {
  flex: 1;
  min-width: 0;
}

.baby-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--shade);
  display: flex;
  align-items: center;
}

.baby-gender {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--brand-deep);
  background: var(--line);
  border-radius: 20rpx;
  padding: 2rpx 12rpx;
  margin-left: 14rpx;
}

.baby-age {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-strong);
  margin-top: 6rpx;
}

.baby-meta {
  font-size: 22rpx;
  color: var(--text-warm);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.baby-edit {
  font-size: 24rpx;
  color: var(--text-warm);
  padding: 10rpx 4rpx 10rpx 20rpx;
  flex-shrink: 0;
}

/* ---------- 空状态（无宝宝） ---------- */
.baby-empty {
  position: relative;
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.baby-empty-emoji {
  font-size: 76rpx;
  line-height: 1.2;
}

.baby-empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--shade);
  margin-top: 8rpx;
}

.baby-empty-desc {
  font-size: 24rpx;
  color: var(--text-warm);
  margin: 10rpx 40rpx 24rpx;
  line-height: 1.6;
}

.baby-empty-btn {
  display: inline-block;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 56rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(240, 135, 107, 0.3);
}

/* ---------- 四宫格 ---------- */
.tip-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.tip-card {
  width: 48.4%;
  background: var(--card);
  border-radius: 30rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 10rpx 26rpx var(--shadow);
}

.tip-badge {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.tip-emoji {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.tip-heading {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.45;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.tip-summary {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.55;
  margin-top: 10rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
/* ---------- 无宝宝时的说明卡 ---------- */
.flat-tip {
  margin-top: 24rpx;
}

.flat-tip-item {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.8;
  margin-top: 12rpx;
}

/* ---------- 记一笔 ---------- */
.quick-log {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 0 24rpx;
}

.quick-log-item {
  flex: 1;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 0 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx var(--shadow);
}

.quick-log-item:active {
  transform: scale(0.97);
  background: var(--bg);
}

.quick-log-emoji {
  font-size: 44rpx;
  line-height: 1.2;
}

.quick-log-text {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
  margin-top: 8rpx;
}

.recent-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.recent-more {
  font-size: 24rpx;
  color: var(--text-4);
}

.recent-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 2rpx dashed var(--line);
}

.recent-item:first-of-type {
  border-top: none;
}

.recent-emoji {
  font-size: 36rpx;
  width: 56rpx;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-when {
  font-size: 22rpx;
  color: var(--text-4);
  margin-left: 16rpx;
}
/* ---------- 天气空态 ---------- */

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
  width: 80%;
  background: linear-gradient(90deg, var(--sunken-2) 25%, var(--sunken) 50%, var(--sunken-2) 75%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.skeleton-short {
  width: 50%;
}

@keyframes skeleton-shine {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* ---------- 一键记一餐 ---------- */
.suggest-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(120deg, var(--brand-tint) 0%, var(--card) 100%);
  border: 2rpx solid var(--peach-soft);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin: 8rpx 0 20rpx;
}

.suggest-bar:active {
  opacity: 0.85;
}

.suggest-emoji {
  font-size: 48rpx;
}

.suggest-main {
  flex: 1;
  min-width: 0;
}

.suggest-slot {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.suggest-name {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggest-cta {
  flex: none;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--on-brand);
  background: linear-gradient(135deg, var(--brand-light), var(--brand));
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
}

/* ---------- 照护状态卡 ---------- */
.care-card {
  padding: 24rpx 28rpx 20rpx;
  margin-bottom: 20rpx;
}

.care-alert {
  font-size: 24rpx;
  color: var(--danger-text);
  background: var(--danger-soft);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.care-line {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.care-emoji {
  font-size: 34rpx;
  width: 56rpx;
}

.care-main {
  flex: 1;
  min-width: 0;
}

.care-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.care-text-empty {
  font-weight: 400;
  color: var(--text-4);
}

.care-text-live {
  color: var(--brand-strong);
}

.care-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.care-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.care-act {
  flex: 1;
  text-align: center;
  background: var(--bg);
  border-radius: 22rpx;
  padding: 18rpx 0 14rpx;
}

.care-act:active {
  transform: scale(0.97);
}

.care-act-on {
  background: var(--brand);
}

.care-act-on .care-act-text {
  color: var(--on-brand);
}

.care-act-sleep {
  background: var(--sleep);
}

.care-act-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.care-act-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
  margin-top: 6rpx;
}

/* ---------- 疫苗到期提醒 ---------- */
.vax-remind {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--info-soft);
  border: 2rpx solid var(--sleep-soft);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.vax-remind:active {
  opacity: 0.85;
}

.vax-remind-over {
  background: var(--warn-soft);
  border-color: var(--amber-soft);
}

.vax-remind-emoji {
  font-size: 40rpx;
}

.vax-remind-main {
  flex: 1;
  min-width: 0;
}

.vax-remind-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.vax-remind-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.vax-remind-go {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--info);
}

.vax-remind-over .vax-remind-go {
  color: var(--warn);
}

/* ---------- 推送收起成一行 ---------- */
.push-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--card);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-top: 8rpx;
}

.push-line:active {
  opacity: 0.8;
}

.push-line-emoji {
  font-size: 36rpx;
}

.push-line-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}

/* ---------- 首次引导 ---------- */
.onboard {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--brand-tint);
  border: 2rpx dashed var(--brand-soft);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
}

.onboard-main {
  flex: 1;
  min-width: 0;
}

.onboard-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
}

.onboard-sub {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.onboard-acts {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.onboard-btn {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--on-brand);
  background: var(--brand);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.onboard-skip {
  font-size: 22rpx;
  color: var(--text-4);
}

/* ---------- 备份提醒 ---------- */
.backup-remind {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: var(--warn-soft);
  border-radius: 24rpx;
  padding: 20rpx 20rpx 20rpx 24rpx;
  margin: 8rpx 0 20rpx;
}

.backup-remind-emoji {
  font-size: 36rpx;
}

.backup-remind-main {
  flex: 1;
  min-width: 0;
}

.backup-remind-text {
  font-size: 26rpx;
  color: var(--warn-text);
  font-weight: 600;
}

.backup-remind-go {
  font-size: 22rpx;
  color: var(--warn);
  margin-top: 2rpx;
}

.backup-remind-x {
  font-size: 36rpx;
  color: var(--text-5);
  padding: 0 8rpx;
}

/* ---------- 没有宝宝时的样例预览 ---------- */
.demo-label {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  margin: 8rpx 0 12rpx;
}

.demo-card {
  opacity: 0.92;
  border: 2rpx dashed var(--line-strong);
}

.demo-line {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--text);
  padding: 10rpx 0;
}

.demo-line-emoji {
  width: 52rpx;
  font-size: 32rpx;
}

.demo-line-sub {
  color: var(--text-4);
  font-size: 22rpx;
  margin-left: 12rpx;
}

/* ---------- 收敛后：记一笔卡 / 今天卡 ---------- */
.log-card {
  padding: 20rpx 24rpx 12rpx;
  margin-bottom: 20rpx;
}

.log-card .suggest-bar {
  margin: 0 0 16rpx;
}

.log-card .quick-log {
  margin: 0 0 8rpx;
}

.log-card .quick-log-item {
  box-shadow: none;
  background: var(--sunken);
}

.log-card .recent-head {
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.recent-more-solo {
  text-align: center;
  padding: 12rpx 0 4rpx;
}

.today-card {
  padding: 4rpx 28rpx;
  margin-top: 8rpx;
}

.today-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}

.today-row + .today-row {
  border-top: 2rpx solid var(--line);
}

.today-emoji {
  font-size: 40rpx;
  width: 56rpx;
  text-align: center;
  flex: none;
}

.today-main {
  flex: 1;
  min-width: 0;
}

.today-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-btn {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--on-brand);
  background: var(--brand);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.today-btn-line {
  color: var(--brand-strong);
  background: transparent;
  border: 2rpx solid var(--brand-soft);
}

.push-line .row-arrow {
  margin-left: auto;
}

.today-title-warn {
  color: var(--danger-text);
}
