/* pages/place/place.wxss */

.hero {
  margin: 26rpx 0 26rpx;
  padding: 34rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(150deg, var(--brand-tint) 0%, var(--peach-soft) 62%, var(--peach-soft) 100%);
  box-shadow: 0 16rpx 38rpx var(--shadow-strong);
}

.hero-hint {
  font-size: 22rpx;
  color: var(--text-warm);
}

.hero-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--shade);
  line-height: 1.35;
  margin-top: 10rpx;
}

.hero-meta {
  font-size: 22rpx;
  color: var(--text-warm);
  margin-top: 10rpx;
}

.hero-tags {
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--amber);
  background: var(--warn-soft);
  border-radius: 18rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 8rpx 0;
  line-height: 1.5;
}

.tag-plain {
  color: var(--text-warm);
  background: var(--glass-strong);
}

/* ---------- 区县 ---------- */
.card-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
  line-height: 1.6;
}

.dist-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.dist {
  width: 23.5%;
  margin: 0 2% 16rpx 0;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--sunken);
  color: var(--text-2);
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.dist:nth-child(4n) {
  margin-right: 0;
}

.dist-on {
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(240, 135, 107, 0.3);
}

.dist-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--mint);
  margin-left: 6rpx;
  display: inline-block;
}

.dist-on .dist-dot {
  background: var(--card);
}

.dist-legend {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  display: flex;
  align-items: center;
}

/* ---------- 搜索 ---------- */
.search-row {
  display: flex;
  align-items: center;
  background: var(--sunken);
  border-radius: 24rpx;
  padding: 0 12rpx 0 24rpx;
  height: 88rpx;
  margin-top: 22rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  height: 88rpx;
}

.search-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.tips {
  font-size: 22rpx;
  line-height: 1.65;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 18rpx;
}

.tips-warn {
  color: var(--amber);
  background: var(--warn-soft);
}

.results {
  margin-top: 18rpx;
  border-top: 2rpx solid var(--sunken-2);
}

.result {
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid var(--sunken-2);
}

.result-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.result-addr {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  line-height: 1.55;
}

.btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.btn-half {
  width: 48.5%;
}

.manual-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed var(--line);
}

.manual-text {
  font-size: 22rpx;
  color: var(--text-4);
}

.manual-btn {
  font-size: 24rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-radius: 22rpx;
  padding: 8rpx 20rpx;
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chosen {
  font-size: 22rpx;
  color: var(--sage);
  background: var(--ok-soft);
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 18rpx;
}

.chosen-name {
  font-weight: 600;
}

/* ---------- 常用地点 ---------- */
.fav {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--sunken-2);
}

.fav-main {
  flex: 1;
  min-width: 0;
}

.fav-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  display: flex;
  align-items: center;
}

.fav-on {
  font-size: 22rpx;
  color: var(--on-brand);
  background: var(--brand);
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.fav-full {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fav-del {
  font-size: 22rpx;
  color: var(--text-5);
  padding: 10rpx 0 10rpx 20rpx;
}

.fav-empty {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.7;
  padding: 20rpx 0;
}

.fav-add {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: var(--sunken);
  border-radius: 22rpx;
  padding: 0 10rpx 0 22rpx;
  height: 80rpx;
}

.fav-input {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  height: 80rpx;
}

.fav-add-btn {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  background: var(--card);
  color: var(--brand-deep);
  font-size: 24rpx;
  flex-shrink: 0;
}

.save-btn {
  margin-top: 12rpx;
}
