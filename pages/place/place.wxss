/* pages/place/place.wxss */

.hero {
  margin: 26rpx 0 26rpx;
  padding: 34rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(150deg, #FFF3E7 0%, #FFE3D2 62%, #FFD8C3 100%);
  box-shadow: 0 16rpx 38rpx rgba(226, 168, 132, 0.22);
}

.hero-hint {
  font-size: 22rpx;
  color: #A9765A;
}

.hero-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #40301F;
  line-height: 1.35;
  margin-top: 10rpx;
}

.hero-meta {
  font-size: 22rpx;
  color: #8A6C55;
  margin-top: 10rpx;
}

.hero-tags {
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #8A5A2E;
  background: #FFF1DD;
  border-radius: 18rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 8rpx 0;
  line-height: 1.5;
}

.tag-plain {
  color: #8A6C55;
  background: rgba(255, 255, 255, 0.7);
}

/* ---------- 区县 ---------- */
.card-sub {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 8rpx;
  line-height: 1.6;
}

.dist-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.dist {
  width: 23.5%;
  margin: 0 2% 16rpx 0;
  height: 76rpx;
  border-radius: 20rpx;
  background: #FBF5EE;
  color: #6B5A4D;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.dist:nth-child(4n) {
  margin-right: 0;
}

.dist-on {
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(240, 135, 107, 0.3);
}

.dist-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #7FB79A;
  margin-left: 6rpx;
  display: inline-block;
}

.dist-on .dist-dot {
  background: #FFFFFF;
}

.dist-legend {
  font-size: 20rpx;
  color: #A8968A;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
}

/* ---------- 搜索 ---------- */
.search-row {
  display: flex;
  align-items: center;
  background: #F8F2EB;
  border-radius: 24rpx;
  padding: 0 12rpx 0 24rpx;
  height: 88rpx;
  margin-top: 22rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #3A2E26;
  height: 88rpx;
}

.search-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.tips {
  font-size: 22rpx;
  line-height: 1.65;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 18rpx;
}

.tips-warn {
  color: #B4743F;
  background: #FFF6E8;
}

.results {
  margin-top: 18rpx;
  border-top: 2rpx solid #F7EFE7;
}

.result {
  padding: 22rpx 4rpx;
  border-bottom: 2rpx solid #F7EFE7;
}

.result-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2E26;
}

.result-addr {
  font-size: 21rpx;
  color: #A8968A;
  margin-top: 4rpx;
  line-height: 1.55;
}

.btn-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.btn-half {
  width: 48.5%;
}

.manual-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #EFE2D4;
}

.manual-text {
  font-size: 22rpx;
  color: #A8968A;
}

.manual-btn {
  font-size: 24rpx;
  color: #C9694A;
  background: #FFF1E6;
  border-radius: 22rpx;
  padding: 8rpx 20rpx;
  max-width: 380rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chosen {
  font-size: 23rpx;
  color: #5E7A6B;
  background: #EDF6F0;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-top: 18rpx;
}

.chosen-name {
  font-weight: 600;
}

/* ---------- 常用地点 ---------- */
.fav {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F7EFE7;
}

.fav-main {
  flex: 1;
  min-width: 0;
}

.fav-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2E26;
  display: flex;
  align-items: center;
}

.fav-on {
  font-size: 18rpx;
  color: #FFFFFF;
  background: #F0876B;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.fav-full {
  font-size: 21rpx;
  color: #A8968A;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.fav-del {
  font-size: 22rpx;
  color: #C0AFA1;
  padding: 10rpx 0 10rpx 20rpx;
}

.fav-empty {
  font-size: 22rpx;
  color: #A8968A;
  line-height: 1.7;
  padding: 20rpx 0;
}

.fav-add {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: #F8F2EB;
  border-radius: 22rpx;
  padding: 0 10rpx 0 22rpx;
  height: 80rpx;
}

.fav-input {
  flex: 1;
  font-size: 26rpx;
  color: #3A2E26;
  height: 80rpx;
}

.fav-add-btn {
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 29rpx;
  background: #FFFFFF;
  color: #C9694A;
  font-size: 24rpx;
  flex-shrink: 0;
}

.save-btn {
  margin-top: 12rpx;
}
