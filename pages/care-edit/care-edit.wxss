/* pages/care-edit/care-edit.wxss */

.top-tip {
  font-size: 24rpx;
  color: var(--text-4);
  padding: 24rpx 8rpx 8rpx;
}

.card-title-gap {
  margin-top: 28rpx;
}

.dt-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.dt-cell {
  background: var(--bg);
  border-radius: 18rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.dt-time {
  min-width: 160rpx;
  text-align: center;
}

.seg {
  display: flex;
  background: var(--bg);
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 12rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-3);
  padding: 16rpx 0;
  border-radius: 16rpx;
}

.seg-on {
  background: var(--card);
  color: var(--brand-strong);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx var(--shadow-strong);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.chip-opt {
  font-size: 26rpx;
  color: var(--text-2);
  background: var(--bg);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

.chip-opt-on {
  color: var(--on-brand);
  background: var(--brand);
}

.colors {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 0;
  margin-top: 16rpx;
}

.color {
  width: 25%;
  text-align: center;
  padding: 6rpx 0;
  border-radius: 16rpx;
}

.color-on {
  background: var(--brand-tint);
}

.swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 0 auto;
  border: 4rpx solid var(--card);
  box-shadow: 0 4rpx 12rpx rgba(58, 46, 38, 0.15);
}

.color-on .swatch {
  box-shadow: 0 0 0 4rpx var(--brand);
}

.color-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-top: 6rpx;
}

.color-tip {
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-top: 16rpx;
}

.color-tip-ok {
  color: var(--ok);
  background: var(--ok-soft);
}

.color-tip-watch {
  color: var(--warn-text);
  background: var(--warn-soft);
}

.color-tip-doctor {
  color: var(--danger-text);
  background: var(--danger-soft);
  font-weight: 600;
}

.field-last {
  border-bottom: none;
}

.del-btn {
  margin-top: 20rpx;
}
