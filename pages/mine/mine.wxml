<view class="page-wrap">

  <!-- 宝宝 -->
  <view class="card baby-card" wx:if="{{baby}}" bindtap="goBaby">
    <view class="baby-avatar">{{baby.avatar}}</view>
    <view class="baby-main">
      <view class="baby-name">{{baby.name}}</view>
      <view class="baby-age">{{baby.ageText}}</view>
    </view>
    <view class="row-go">编辑档案 ›</view>
  </view>
  <view class="card baby-card" wx:else bindtap="goBaby">
    <view class="baby-avatar">🍼</view>
    <view class="baby-main">
      <view class="baby-name">还没添加宝宝</view>
      <view class="baby-age">填好生日，就能按月龄给建议</view>
    </view>
    <view class="row-go">添加 ›</view>
  </view>

  <!-- 设置项 -->
  <view class="card list-card">
    <view class="row" bindtap="goBabies">
      <text class="row-emoji">👶</text>
      <view class="row-main">
        <view class="row-title">宝宝档案</view>
        <view class="row-sub">{{babyCount > 1 ? babyCount + ' 个宝宝，点进去切换' : '添加二宝、切换当前宝宝'}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="row" bindtap="goPlace">
      <text class="row-emoji">📍</text>
      <view class="row-main">
        <view class="row-title">宝宝在哪</view>
        <view class="row-sub">{{placeText}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="row" bindtap="goWeather">
      <text class="row-emoji">🧥</text>
      <view class="row-main">
        <view class="row-title">天气穿衣</view>
        <view class="row-sub">{{manualTempText || '穿几层、睡袋多厚、室温对照表'}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="row" bindtap="goFamily">
      <text class="row-emoji">👨‍👩‍👧</text>
      <view class="row-main">
        <view class="row-title">一起带娃的人</view>
        <view class="row-sub">{{familyText}}</view>
      </view>
      <text class="row-arrow">›</text>
    </view>

    <view class="row" bindtap="goShare">
      <text class="row-emoji">🖼</text>
      <view class="row-main">
        <view class="row-title">今日卡片</view>
        <view class="row-sub">一张图发给家人</view>
      </view>
      <text class="row-arrow">›</text>
    </view>
  </view>

  <!-- 数据与备份 -->
  <view class="card data-card">
    <view class="card-title">数据与备份</view>
    <view class="data-warn">
      <text class="data-warn-icon">📱</text>
      <text>所有记录只存在这台手机上，不会上传。换手机、删除小程序前，记得先备份。</text>
    </view>
    <view class="data-stats">
      <view class="data-stat"><view class="data-num">{{dataStats.babies}}</view><view class="data-key">宝宝</view></view>
      <view class="data-stat"><view class="data-num">{{dataStats.care}}</view><view class="data-key">喂睡尿</view></view>
      <view class="data-stat"><view class="data-num">{{dataStats.meals + dataStats.food}}</view><view class="data-key">辅食</view></view>
      <view class="data-stat"><view class="data-num">{{dataStats.vaccine}}</view><view class="data-key">接种</view></view>
    </view>
    <view class="data-actions">
      <view class="btn btn-ghost btn-sm data-btn" bindtap="exportData">备份到剪贴板</view>
      <view class="btn btn-line btn-sm data-btn" bindtap="importData">从备份恢复</view>
    </view>
    <view class="data-tip">备份也能用来同步：在家人手机上恢复，就能看到同一份记录。</view>
  </view>

  <disclaimer />
</view>
