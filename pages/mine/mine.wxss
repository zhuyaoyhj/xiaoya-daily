/* pages/mine/mine.wxss */

.baby-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, #FFF1E6 0%, #FFFFFF 100%);
}

.baby-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 4rpx 16rpx rgba(213, 176, 147, 0.2);
}

.baby-main {
  flex: 1;
  min-width: 0;
}

.baby-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2E26;
}

.baby-age {
  font-size: 24rpx;
  color: #8C7B6E;
  margin-top: 4rpx;
}

.row-go {
  font-size: 24rpx;
  color: #F0876B;
}

.list-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-top: 2rpx solid #F7EEE5;
}

.row:first-child {
  border-top: none;
}

.row:active {
  opacity: 0.7;
}

.row-emoji {
  font-size: 38rpx;
  width: 64rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  color: #3A2E26;
  font-weight: 600;
}

.row-sub {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow {
  font-size: 32rpx;
  color: #C9B8A9;
  margin-left: 12rpx;
}

/* ---------- 数据与备份 ---------- */
.data-warn {
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: #8C5A3C;
  background: #FFF4EA;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.data-warn-icon {
  flex: none;
}

.data-stats {
  display: flex;
  margin: 24rpx 0 8rpx;
}

.data-stat {
  flex: 1;
  text-align: center;
}

.data-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #D96B4F;
}

.data-key {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 2rpx;
}

.data-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.data-btn {
  flex: 1;
}

.data-tip {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 16rpx;
  line-height: 1.6;
}
