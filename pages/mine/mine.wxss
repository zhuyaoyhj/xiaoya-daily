/* pages/mine/mine.wxss */

.baby-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(135deg, var(--brand-tint) 0%, var(--card) 100%);
}

.baby-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-strong);
}

.baby-main {
  flex: 1;
  min-width: 0;
}

.baby-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.baby-age {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.row-go {
  font-size: 24rpx;
  color: var(--brand);
}

.list-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-top: 2rpx solid var(--sunken-2);
}

.row:first-child {
  border-top: none;
}

.row:active {
  opacity: 0.7;
}

.row-emoji {
  font-size: 38rpx;
  width: 64rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.row-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 数据与备份 ---------- */
.data-warn {
  display: flex;
  gap: 12rpx;
  font-size: 24rpx;
  color: var(--cocoa);
  background: var(--brand-tint);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.data-warn-icon {
  flex: none;
}

.data-stats {
  display: flex;
  margin: 24rpx 0 8rpx;
}

.data-stat {
  flex: 1;
  text-align: center;
}

.data-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-strong);
}

.data-key {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 2rpx;
}

.data-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.data-btn {
  flex: 1;
}

.data-tip {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 16rpx;
  line-height: 1.6;
}

.data-more {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  margin-top: 16rpx;
  padding: 8rpx 0;
}

.data-backup {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 16rpx;
}

.data-backup-stale {
  color: var(--warn-text);
  font-weight: 600;
}
