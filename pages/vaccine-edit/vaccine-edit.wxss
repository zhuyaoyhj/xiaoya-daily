/* pages/vaccine-edit/vaccine-edit.wxss */

.edit-wrap {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.top-tip {
  font-size: 24rpx;
  color: #8C7B6E;
  padding: 12rpx 8rpx 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pick-name {
  font-size: 21rpx;
  color: #B2886F;
}

/* ---------- 分类 ---------- */
.cat-row {
  display: flex;
  margin-bottom: 20rpx;
}

.cat-chip {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  color: #8C7B6E;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-right: 16rpx;
  border: 2rpx solid #F4E7DA;
}

.cat-chip:last-child {
  margin-right: 0;
}

.cat-chip-on {
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(240, 135, 107, 0.28);
}

/* ---------- 疫苗网格 ---------- */
.vax-grid {
  display: flex;
  flex-wrap: wrap;
}

.vax-item {
  width: calc((100% - 32rpx) / 3);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 10rpx 20rpx;
  border-radius: 24rpx;
  background: #FBF7F2;
  border: 2rpx solid transparent;
  text-align: center;
  box-sizing: border-box;
}

.vax-item:nth-child(3n) {
  margin-right: 0;
}

.vax-item-on {
  background: #FFF1E6;
  border-color: #F0A187;
}

.vax-item-name {
  font-size: 26rpx;
  color: #3A2E26;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vax-item-on .vax-item-name {
  color: #C9694A;
  font-weight: 600;
}

.vax-item-dose {
  font-size: 18rpx;
  color: #A99A8C;
  margin-top: 6rpx;
}

.vax-item-flag {
  font-size: 16rpx;
  color: #7A6AA8;
  background: #F0EBFA;
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-top: 6rpx;
  display: inline-block;
}

.vax-item-add {
  border: 2rpx dashed #E4D3C4;
  background: #FFFDFB;
}

.vax-item-add .vax-item-name {
  color: #A99A8C;
}

/* ---------- 自定义疫苗浮层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.42);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: #FFF8F0;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #E4D3C4;
  margin: 0 auto 24rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2E26;
}

.sheet-desc {
  font-size: 22rpx;
  color: #9A8A7C;
  line-height: 1.6;
  margin: 8rpx 0 24rpx;
}

.sheet-field {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.sheet-label {
  font-size: 22rpx;
  color: #8C7B6E;
  margin-bottom: 10rpx;
}

.sheet-input {
  font-size: 28rpx;
  color: #3A2E26;
  height: 60rpx;
}

.sheet-note {
  width: 100%;
  height: 110rpx;
  font-size: 25rpx;
  color: #3A2E26;
  line-height: 1.6;
}

.sheet-dose-row {
  display: flex;
}

.sheet-dose {
  width: 72rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8C7B6E;
  background: #FBF7F2;
  border-radius: 18rpx;
  margin-right: 14rpx;
  border: 2rpx solid transparent;
}

.sheet-dose-on {
  background: #FFF1E6;
  border-color: #F0A187;
  color: #C9694A;
  font-weight: 600;
}

.sheet-btn {
  margin: 8rpx 0 24rpx;
}

.sheet-sub {
  font-size: 22rpx;
  color: #9A8A7C;
  padding: 8rpx 4rpx 12rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
}

.sheet-item-name {
  flex: 1;
  font-size: 25rpx;
  color: #3A2E26;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-item-dose {
  font-size: 20rpx;
  color: #A99A8C;
  margin: 0 16rpx;
  flex-shrink: 0;
}

.sheet-item-del {
  font-size: 22rpx;
  color: #C9694A;
  flex-shrink: 0;
}

/* ---------- 剂次 ---------- */
.dose-row {
  display: flex;
  flex-wrap: wrap;
}

.dose-chip {
  min-width: 196rpx;
  padding: 16rpx 22rpx;
  border-radius: 22rpx;
  background: #FBF7F2;
  border: 2rpx solid transparent;
  margin: 0 16rpx 16rpx 0;
  box-sizing: border-box;
}

.dose-chip-on {
  background: #FFF1E6;
  border-color: #F0A187;
}

.dose-chip text {
  display: block;
  font-size: 25rpx;
  color: #3A2E26;
}

.dose-chip-on text:first-child {
  color: #C9694A;
  font-weight: 600;
}

.dose-label {
  font-size: 19rpx !important;
  color: #A99A8C !important;
  margin-top: 4rpx;
}

.dose-done {
  font-size: 18rpx !important;
  color: #6E8F62 !important;
  margin-top: 4rpx;
}

/* ---------- 信息行 ---------- */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.info-key {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #8C7B6E;
}

.info-val {
  flex: 1;
  font-size: 25rpx;
  color: #3A2E26;
  line-height: 1.6;
}

.mini-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B5A4D;
  margin-bottom: 10rpx;
}

.mini-item {
  font-size: 23rpx;
  color: #8C7B6E;
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.time-hint {
  font-size: 20rpx;
  color: #A99A8C;
  line-height: 1.6;
  padding: 10rpx 0 6rpx;
}

.note-area {
  width: 100%;
  min-height: 160rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #3A2E26;
  line-height: 1.6;
}

/* ---------- 删除 ---------- */
.del-btn {
  margin-top: 8rpx;
  color: #C9694A;
  border-color: #F2D9CF;
}

/* ---------- 底部固定 ---------- */
.sticky-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 248, 240, 0) 0%, #FFF8F0 32%);
}

.btn-disabled {
  opacity: 0.45;
}
