/* pages/vaccine-edit/vaccine-edit.wxss */

.edit-wrap {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.top-tip {
  font-size: 24rpx;
  color: var(--text-3);
  padding: 12rpx 8rpx 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pick-name {
  font-size: 22rpx;
  color: var(--text-warm);
}

/* ---------- 分类 ---------- */
.cat-row {
  display: flex;
  margin-bottom: 20rpx;
}

.cat-chip {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
  color: var(--text-3);
  background: var(--card);
  border-radius: 24rpx;
  margin-right: 16rpx;
  border: 2rpx solid var(--line);
}

.cat-chip:last-child {
  margin-right: 0;
}

.cat-chip-on {
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  border-color: transparent;
  box-shadow: 0 10rpx 24rpx rgba(240, 135, 107, 0.28);
}

/* ---------- 疫苗网格 ---------- */
.vax-grid {
  display: flex;
  flex-wrap: wrap;
}

.vax-item {
  width: calc((100% - 32rpx) / 3);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 10rpx 20rpx;
  border-radius: 24rpx;
  background: var(--sunken);
  border: 2rpx solid transparent;
  text-align: center;
  box-sizing: border-box;
}

.vax-item:nth-child(3n) {
  margin-right: 0;
}

.vax-item-on {
  background: var(--brand-tint);
  border-color: var(--brand-light);
}

.vax-item-name {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vax-item-on .vax-item-name {
  color: var(--brand-deep);
  font-weight: 600;
}

.vax-item-dose {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

.vax-item-flag {
  font-size: 22rpx;
  color: var(--sleep);
  background: var(--sleep-soft);
  border-radius: 8rpx;
  padding: 0 8rpx;
  margin-top: 6rpx;
  display: inline-block;
}

.vax-item-add {
  border: 2rpx dashed var(--line-strong);
  background: var(--card);
}

.vax-item-add .vax-item-name {
  color: var(--text-4);
}

/* ---------- 自定义疫苗浮层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.42);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  overflow-y: auto;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-bar {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--line-strong);
  margin: 0 auto 24rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.sheet-desc {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  margin: 8rpx 0 24rpx;
}

.sheet-field {
  background: var(--card);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.sheet-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 10rpx;
}

.sheet-input {
  font-size: 28rpx;
  color: var(--text);
  height: 60rpx;
}

.sheet-note {
  width: 100%;
  height: 110rpx;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

.sheet-dose-row {
  display: flex;
}

.sheet-dose {
  width: 72rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
  background: var(--sunken);
  border-radius: 18rpx;
  margin-right: 14rpx;
  border: 2rpx solid transparent;
}

.sheet-dose-on {
  background: var(--brand-tint);
  border-color: var(--brand-light);
  color: var(--brand-deep);
  font-weight: 600;
}

.sheet-btn {
  margin: 8rpx 0 24rpx;
}

.sheet-sub {
  font-size: 22rpx;
  color: var(--text-4);
  padding: 8rpx 4rpx 12rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 12rpx;
}

.sheet-item-name {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sheet-item-dose {
  font-size: 22rpx;
  color: var(--text-4);
  margin: 0 16rpx;
  flex-shrink: 0;
}

.sheet-item-del {
  font-size: 22rpx;
  color: var(--brand-deep);
  flex-shrink: 0;
}

/* ---------- 剂次 ---------- */
.dose-row {
  display: flex;
  flex-wrap: wrap;
}

.dose-chip {
  min-width: 196rpx;
  padding: 16rpx 22rpx;
  border-radius: 22rpx;
  background: var(--sunken);
  border: 2rpx solid transparent;
  margin: 0 16rpx 16rpx 0;
  box-sizing: border-box;
}

.dose-chip-on {
  background: var(--brand-tint);
  border-color: var(--brand-light);
}

.dose-chip text {
  display: block;
  font-size: 24rpx;
  color: var(--text);
}

.dose-chip-on text:first-child {
  color: var(--brand-deep);
  font-weight: 600;
}

.dose-label {
  font-size: 22rpx !important;
  color: var(--text-4) !important;
  margin-top: 4rpx;
}

.dose-done {
  font-size: 22rpx !important;
  color: var(--leaf) !important;
  margin-top: 4rpx;
}

/* ---------- 信息行 ---------- */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.info-key {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
}

.info-val {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

.mini-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-bottom: 10rpx;
}

.mini-item {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.7;
}

/* ---------- 表单 ---------- */
.time-hint {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  padding: 10rpx 0 6rpx;
}

.note-area {
  width: 100%;
  min-height: 160rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ---------- 删除 ---------- */
.del-btn {
  margin-top: 8rpx;
  color: var(--brand-deep);
  border-color: var(--line-strong);
}

/* ---------- 底部固定 ---------- */
.sticky-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 248, 240, 0) 0%, var(--bg) 32%);
}

.btn-disabled {
  opacity: 0.45;
}
