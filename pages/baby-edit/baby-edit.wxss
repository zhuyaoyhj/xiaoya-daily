/* pages/baby-edit/baby-edit.wxss */

/* ---------- 头像 ---------- */
.avatar-card {
  text-align: center;
  padding: 36rpx 28rpx 28rpx;
}

.avatar-preview {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  margin: 0 auto;
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--peach-soft) 100%);
  font-size: 76rpx;
  line-height: 148rpx;
  box-shadow: 0 10rpx 26rpx var(--shadow-strong);
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 16rpx;
}

.avatar-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 20rpx;
}

.avatar-opt {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  font-size: 40rpx;
  line-height: 78rpx;
  text-align: center;
  margin: 8rpx;
  background: var(--sunken);
  border: 3rpx solid transparent;
}

.avatar-on {
  background: var(--card);
  border-color: var(--brand);
  box-shadow: 0 6rpx 18rpx rgba(240, 135, 107, 0.24);
}

/* ---------- 性别 ---------- */
.gender-wrap {
  flex: 1;
  display: flex;
  justify-content: flex-end;
}

.gender-opt {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 32rpx;
  border-radius: 31rpx;
  background: var(--sunken);
  color: var(--text-3);
  font-size: 26rpx;
  margin-left: 16rpx;
}

.gender-on {
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  font-weight: 600;
}

/* ---------- 其他 ---------- */
.age-preview {
  font-size: 22rpx;
  color: var(--brand-strong);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  margin: 18rpx 0 6rpx;
}

.field-textarea {
  align-items: flex-start;
  padding: 26rpx 0;
}

.field-textarea-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  text-align: right;
  min-height: 88rpx;
  line-height: 1.6;
}

/* ---------- 列表 ---------- */
.baby-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 30rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 10rpx 26rpx var(--shadow);
  border: 3rpx solid transparent;
}

.baby-item-on {
  border-color: var(--brand-soft);
  background: var(--sunken);
}

.baby-item-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--brand-tint);
  font-size: 48rpx;
  line-height: 92rpx;
  text-align: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.baby-item-main {
  flex: 1;
  min-width: 0;
}

.baby-item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.baby-item-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 6rpx;
}

.baby-item-check {
  font-size: 22rpx;
  color: var(--on-brand);
  background: var(--brand);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  margin-right: 12rpx;
}

.baby-item-edit {
  font-size: 24rpx;
  color: var(--text-warm);
  padding: 10rpx 0 10rpx 16rpx;
}

.add-btn {
  margin-top: 12rpx;
}

.delete-btn {
  margin-top: 20rpx;
  color: var(--brand-deep);
  border-color: var(--line-strong);
}

.local-note {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
  line-height: 1.6;
  padding: 24rpx 24rpx 0;
}

.field-hint {
  color: var(--text-4);
  font-size: 24rpx;
}

.preterm-note {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  padding: 4rpx 8rpx 8rpx;
}
