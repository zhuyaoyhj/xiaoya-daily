@import "/components/care-panel/care-panel.wxss";

/* pages/record/record.wxss */

.empty-card {
  text-align: center;
  padding: 60rpx 32rpx;
  margin-top: 28rpx;
}

.empty-emoji {
  font-size: 72rpx;
}

.empty-desc {
  margin: 12rpx 0 28rpx;
}

/* ---------- 大按钮 ---------- */
.acts {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0 8rpx;
}

.act {
  flex: 1;
  text-align: center;
  background: var(--card);
  border-radius: 28rpx;
  padding: 28rpx 0 22rpx;
  box-shadow: 0 6rpx 20rpx rgba(213, 176, 147, 0.15);
}

.act:active {
  transform: scale(0.97);
}

.act-on {
  background: var(--brand);
}

.act-on .act-text {
  color: var(--card);
}

.act-sleep {
  background: var(--sleep);
}

.act-emoji {
  font-size: 52rpx;
  line-height: 1.2;
}

.act-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 8rpx;
}

.acts-past .act-line {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-strong);
  padding: 26rpx 0;
  box-shadow: none;
  border: 2rpx dashed var(--brand-soft);
}

/* ---------- 日期 ---------- */
.day-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 0 8rpx;
}

.day-nav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--card);
  color: var(--brand-strong);
  font-size: 40rpx;
  line-height: 68rpx;
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(213, 176, 147, 0.15);
}

.day-nav-off {
  opacity: 0.3;
}

.day-label {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.day-arrow {
  font-size: 22rpx;
  color: var(--text-4);
}

.back-today {
  text-align: center;
  font-size: 24rpx;
  color: var(--brand-strong);
  margin-bottom: 8rpx;
}

/* ---------- 汇总 ---------- */
.sum-card {
  margin-top: 16rpx;
  padding: 28rpx 24rpx 20rpx;
}

.sum-grid {
  display: flex;
}

.sum-cell {
  flex: 1;
  text-align: center;
}

.sum-cell + .sum-cell {
  border-left: 2rpx solid var(--sunken-2);
}

.sum-num {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--brand-strong);
  line-height: 1.3;
}

.sum-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-4);
  margin-left: 2rpx;
}

.sum-key {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 600;
  margin-top: 4rpx;
}

.sum-ref {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.sum-extra {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--line);
}

.hint {
  font-size: 24rpx;
  line-height: 1.6;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-top: 16rpx;
}

.hint-watch {
  color: var(--warn-text);
  background: var(--warn-soft);
}

.hint-doctor {
  color: var(--danger-text);
  background: var(--danger-soft);
  font-weight: 600;
}

/* ---------- 时间线 ---------- */
.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 0 16rpx;
}

.tl-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.tl-filters {
  display: flex;
  gap: 10rpx;
}

.tl-filter {
  font-size: 22rpx;
  color: var(--text-3);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--card);
}

.tl-filter-on {
  color: var(--card);
  background: var(--brand);
}

.tl-card {
  padding: 12rpx 24rpx;
}

.tl-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--sunken-2);
}

.tl-row:first-child {
  border-top: none;
}

.tl-row:active {
  opacity: 0.7;
}

.tl-time {
  width: 104rpx;
  flex: none;
  font-size: 24rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
  padding-top: 2rpx;
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: 12rpx 18rpx 0 0;
  flex: none;
}

.tl-dot-feed {
  background: var(--brand);
}

.tl-dot-sleep {
  background: var(--sleep);
}

.tl-dot-diaper {
  background: var(--warn-strong);
}

.tl-main {
  flex: 1;
  min-width: 0;
}

.tl-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
}

.tl-swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 2rpx solid var(--card);
  box-shadow: 0 0 0 2rpx var(--line-strong);
}

.tl-detail {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.tl-detail-doctor {
  color: var(--danger-text);
  font-weight: 600;
}

.tl-go {
  font-size: 32rpx;
  color: var(--text-5);
  margin-left: 8rpx;
}

.tl-empty {
  text-align: center;
  padding: 48rpx 24rpx;
}

/* ---------- 更多记录 ---------- */
.more-card {
  padding: 8rpx 28rpx;
}

.more-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--sunken-2);
}

.more-row:first-child {
  border-top: none;
}

.more-row:active {
  opacity: 0.7;
}

.more-emoji {
  font-size: 38rpx;
  width: 64rpx;
}

.more-main {
  flex: 1;
  min-width: 0;
}

.more-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.more-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.more-go {
  font-size: 32rpx;
  color: var(--text-5);
}
