/* pages/food/food.wxss —— 辅食主页 */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* ---------- 状态卡 ---------- */
.hero {
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(140deg, #FFF1E6 0%, #FFE4D3 100%);
  box-shadow: 0 12rpx 32rpx rgba(213, 176, 147, 0.18);
}

.hero-pre {
  background: linear-gradient(140deg, #F3F1FA 0%, #E7E2F3 100%);
}

.hero-todo {
  background: linear-gradient(140deg, #FFF1E6 0%, #FFE4D3 100%);
}

.hero-watch {
  background: linear-gradient(140deg, #FDF4E3 0%, #F8E7C8 100%);
}

.hero-warn {
  background: linear-gradient(140deg, #FFEFEA 0%, #FBDCD2 100%);
}

.hero-ok {
  background: linear-gradient(140deg, #EFF6EF 0%, #DFEEDF 100%);
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-face {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.hero-id {
  flex: 1;
}

.hero-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A2E26;
}

.hero-age {
  font-size: 22rpx;
  color: #8C7B6E;
  margin-top: 4rpx;
}

.hero-chip {
  font-size: 21rpx;
  color: #7A6A5C;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #3A2E26;
  line-height: 1.4;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #7A6A5C;
  line-height: 1.65;
}

.hero-meta {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.hero-meta-item {
  font-size: 21rpx;
  color: #8C7B6E;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
}

/* ---------- 空状态 ---------- */
.empty-desc {
  font-size: 24rpx;
  line-height: 1.7;
  margin: 10rpx 0 20rpx;
}

.empty-btn {
  display: inline-block;
}

/* ---------- 未到月龄 ---------- */
.ready-card {
  background: #F8F6FD;
}

.ready-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
}

.ready-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #A88FC4;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.ready-text {
  flex: 1;
  font-size: 24rpx;
  color: #4A3F3A;
  line-height: 1.65;
}

.ready-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8A7BA6;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  padding: 16rpx;
  line-height: 1.65;
}

/* ---------- 正在排敏 ---------- */
.watch-card {
  background: #FFFBF2;
  border: 2rpx solid #F5E3C2;
}

.watch-badge {
  font-size: 20rpx;
  color: #A97A22;
  background: #FDF1DC;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.watch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.watch-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.watch-body {
  flex: 1;
}

.watch-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #3A2E26;
}

.watch-sub {
  font-size: 22rpx;
  color: #9A8355;
  margin-top: 4rpx;
  line-height: 1.6;
}

.conflict {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: #FFE7E3;
  color: #B22F1F;
  font-size: 22rpx;
  line-height: 1.65;
  border-radius: 14rpx;
}

/* ---------- 今天吃什么 ---------- */
.today-label {
  font-size: 22rpx;
  color: #B3A195;
  margin: -8rpx 0 14rpx 4rpx;
}

.meal-card {
  padding: 12rpx 32rpx 22rpx;
}

.meal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.meal-row:last-of-type {
  border-bottom: none;
}

.meal-slot {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #A08D7D;
}

.meal-body {
  flex: 1;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3A2E26;
}

.meal-sub {
  font-size: 21rpx;
  color: #B3A195;
  margin-top: 4rpx;
}

.meal-new {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #A97A22;
  background: #FDF1DC;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  display: inline-block;
}

.meal-swap {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #C4643F;
  background: #FFEDE4;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.meal-foot {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #C0AFA0;
  text-align: center;
}

/* ---------- 一周餐单 ---------- */
.week-note {
  font-size: 22rpx;
  color: #9A8355;
  background: #FDF7EE;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.week-row {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.week-row:last-child {
  border-bottom: none;
}

.week-row-on {
  background: #FFF7F0;
  border-radius: 16rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.week-day {
  width: 92rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.week-weekday {
  font-size: 24rpx;
  font-weight: 600;
  color: #3A2E26;
}

.week-date {
  font-size: 20rpx;
  color: #B3A195;
  margin-top: 2rpx;
}

.week-meals {
  flex: 1;
}

.week-meal {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 4rpx 0;
}

.week-meal-slot {
  font-size: 20rpx;
  color: #B3A195;
  width: 56rpx;
  flex-shrink: 0;
}

.week-meal-name {
  font-size: 24rpx;
  color: #4A3F3A;
  line-height: 1.5;
}

/* ---------- 待尝试 ---------- */
.due-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F6ECE2;
}

.due-row:last-child {
  border-bottom: none;
}

.due-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0;
}

.due-body {
  flex: 1;
}

.due-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #3A2E26;
}

.due-sub {
  font-size: 21rpx;
  color: #B3A195;
  margin-top: 4rpx;
}

.due-tag {
  font-size: 19rpx;
  border-radius: 8rpx;
  padding: 3rpx 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.due-tag-iron {
  color: #B4553F;
  background: #FFEDE6;
}

.due-tag-allergen {
  color: #A97A22;
  background: #FDF1DC;
}

.due-tag-custom {
  color: #8A7BA6;
  background: #F2ECFA;
}

.due-arrow {
  font-size: 30rpx;
  color: #D6C6B8;
}

.due-skip {
  flex-shrink: 0;
  font-size: 21rpx;
  color: #A08D7D;
  padding: 10rpx 0 10rpx 18rpx;
}

.calm-card {
  background: #F4F8F4;
}

.calm-title {
  font-size: 27rpx;
  font-weight: 600;
  color: #43664A;
}

.calm-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6D8570;
  line-height: 1.65;
}

/* ---------- 阶段要点 ---------- */
.stage-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #7A6A5C;
  background: #FBF3E9;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 14rpx;
}

.kv {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.kv-key {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: #A08D7D;
}

.kv-val {
  flex: 1;
  font-size: 24rpx;
  color: #3A2E26;
  line-height: 1.65;
}

.mini-title {
  font-size: 23rpx;
  font-weight: 600;
  color: #6B5A4D;
  margin: 12rpx 0 8rpx;
}

.mini-item {
  font-size: 23rpx;
  color: #6B5A4D;
  line-height: 1.75;
}

.avoid-item {
  color: #9A6A5C;
}

/* ---------- 已尝试 ---------- */
.rec-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.rec-row:last-of-type {
  border-bottom: none;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-name {
  font-size: 27rpx;
  font-weight: 500;
  color: #3A2E26;
}

.rec-sub {
  font-size: 21rpx;
  color: #B3A195;
  margin-top: 5rpx;
  line-height: 1.55;
}

.rec-note {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8C7B6E;
  background: #FBF6F0;
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  line-height: 1.5;
}

.rec-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.rec-tag {
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
}

.tag-ok {
  background: #EAF3EC;
  color: #4B7C5C;
}

.tag-watch {
  background: #FDF1DC;
  color: #A97A22;
}

.tag-warn {
  background: #FFE7E3;
  color: #C43C2A;
}

.tag-danger {
  background: #B02A1C;
  color: #FFF3F0;
}

.rec-group {
  font-size: 19rpx;
  color: #C0AFA0;
}

.rec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
}

.rec-foot-text {
  font-size: 21rpx;
  color: #B3A195;
}

.rec-toggle {
  font-size: 21rpx;
  color: #C4643F;
}

/* ---------- 过敏原 ---------- */
.allergen-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.allergen-row:last-child {
  border-bottom: none;
}

.allergen-emoji {
  width: 48rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.allergen-body {
  flex: 1;
}

.allergen-name {
  font-size: 24rpx;
  font-weight: 500;
  color: #8C7B6E;
}

.allergen-done {
  color: #4B7C5C;
}

.allergen-tip {
  font-size: 21rpx;
  color: #A08D7D;
  line-height: 1.6;
  margin-top: 4rpx;
}

/* ---------- 食材库 ---------- */
.lib-group {
  font-size: 22rpx;
  font-weight: 600;
  color: #8C7B6E;
  margin: 18rpx 0 10rpx;
}

.lib-group:first-child {
  margin-top: 0;
}

.lib-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.lib-item {
  width: calc((100% - 24rpx) / 3);
  padding: 14rpx 8rpx;
  background: #FDF9F4;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lib-name {
  font-size: 23rpx;
  color: #3A2E26;
  text-align: center;
  line-height: 1.3;
}

.lib-flag {
  font-size: 18rpx;
  color: #B3A195;
  margin-top: 4rpx;
}

.flag-ok {
  color: #4B7C5C;
}

.flag-watch {
  color: #A97A22;
}

.flag-bad {
  color: #C43C2A;
}

.flag-mute {
  color: #B3A195;
}

.flag-due {
  color: #C4643F;
}

.add-btn {
  margin-top: 12rpx;
}

/* ---------- 食谱浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: #FFFDFB;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sheet-emoji {
  font-size: 40rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A2E26;
}

.sheet-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #A08D7D;
}

.sheet-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.sheet-food {
  font-size: 22rpx;
  color: #6B5A4D;
  background: #FBF3E9;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.sheet-step {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
}

.sheet-step-no {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #FFEDE4;
  color: #C4643F;
  font-size: 20rpx;
  text-align: center;
  line-height: 34rpx;
  margin-top: 4rpx;
}

.sheet-step-text {
  flex: 1;
  font-size: 24rpx;
  color: #3A2E26;
  line-height: 1.7;
}

.sheet-tip {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #FDF7EE;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #9A8355;
  line-height: 1.7;
}

.sheet-close {
  margin-top: 28rpx;
}

/* ---------- 逐月重点 ---------- */
/* 待尝试列表上方的月份提示 */
.due-month {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx 14rpx;
}

.due-month-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #C4703C;
}

.due-month-sub {
  font-size: 21rpx;
  color: #B0A091;
}

/* 阶段卡里的本月重点 */
.focus-box {
  margin: 6rpx 0 14rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(135deg, #FFF7EE 0%, #FFF1E2 100%);
  border-radius: 20rpx;
  border-left: 6rpx solid #F0B37E;
}

.focus-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #A9582A;
  margin-bottom: 8rpx;
}

.focus-text {
  font-size: 23rpx;
  color: #5C4A3D;
  line-height: 1.7;
}

.focus-key {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8A6A4E;
  line-height: 1.6;
}

.focus-key::before {
  content: '· ';
  color: #F0B37E;
  font-weight: 700;
}

.focus-next {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #B07B4A;
}

.focus-hint {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #B6A697;
  line-height: 1.6;
}

/* ---------- 接种期就餐约束 ---------- */
.diet-bar {
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #E0B15C;
  background: linear-gradient(135deg, #FDF6E8 0%, #FBEFDC 100%);
}

.diet-strict {
  border-left-color: #D9603F;
  background: linear-gradient(135deg, #FDF0EC 0%, #FBE6DF 100%);
}

.diet-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #8F6A1E;
  margin-bottom: 8rpx;
}

.diet-strict .diet-title {
  color: #B4553F;
}

.diet-desc {
  font-size: 23rpx;
  color: #7A6647;
  line-height: 1.7;
}

.diet-strict .diet-desc {
  color: #8A5A48;
}

.diet-foot {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #A08D7D;
}

/* ---------- 今天吃什么：理由与打卡 ---------- */
.meal-reason {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8C7B6E;
}

.meal-log {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #4B7C5C;
  background: #EAF3EC;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---------- 接着两天 ---------- */
.plan-card {
  padding: 8rpx 32rpx 20rpx;
}

.plan-day {
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #EFE2D4;
}

.plan-day:last-child {
  border-bottom: none;
}

.plan-day-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.plan-day-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #C4703C;
}

.plan-day-date {
  font-size: 20rpx;
  color: #B3A195;
}

.plan-meal {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.plan-meal-slot {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  color: #A08D7D;
}

.plan-meal-body {
  flex: 1;
}

.plan-meal-name {
  font-size: 25rpx;
  color: #3A2E26;
}

.plan-meal-reason {
  font-size: 19rpx;
  color: #B0A091;
  margin-top: 2rpx;
}

.plan-meal-log {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4B7C5C;
  background: #F1F7F2;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

/* ---------- 最近吃了什么 ---------- */
.log-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.log-row:last-of-type {
  border-bottom: none;
}

.log-body {
  flex: 1;
}

.log-title {
  font-size: 27rpx;
  font-weight: 500;
  color: #3A2E26;
}

.log-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #A08D7D;
}

.log-note {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8C7B6E;
}

.log-arrow {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #D8C7B8;
}

.log-foot {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: #C0AFA0;
  text-align: center;
}

/* ---------- 吃过但没记排敏 ---------- */
.tip-bar {
  background: linear-gradient(135deg, #FDF6E8 0%, #FBEFDC 100%);
  border-left: 6rpx solid #E0B15C;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  font-size: 25rpx;
  font-weight: 600;
  color: #8F6A1E;
}

.tip-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9A8355;
  line-height: 1.65;
}

.tip-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tip-chip {
  font-size: 22rpx;
  color: #A9582A;
  background: #FFFFFF;
  border: 2rpx solid #EBD3A2;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---------- 当季一行 ---------- */
.season-line {
  margin: 6rpx 0 14rpx;
  font-size: 21rpx;
  color: #8A7A66;
  line-height: 1.6;
  background: #FBF7F1;
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}

/* ---------- 食材库「吃过」标记 ---------- */
.lib-eaten {
  font-size: 18rpx;
  color: #6E9980;
  margin-top: 2rpx;
}

/* ---------- 底部双按钮 ---------- */
.act-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.act-btn {
  flex: 1;
}
