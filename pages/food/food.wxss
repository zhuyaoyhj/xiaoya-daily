/* pages/food/food.wxss —— 辅食主页 */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* ---------- 状态卡 ---------- */
.hero {
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--peach-soft) 100%);
  box-shadow: 0 12rpx 32rpx rgba(213, 176, 147, 0.18);
}

.hero-pre {
  background: linear-gradient(140deg, var(--info-soft) 0%, var(--sleep-soft) 100%);
}

.hero-todo {
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--peach-soft) 100%);
}

.hero-watch {
  background: linear-gradient(140deg, var(--warn-soft) 0%, var(--amber-soft) 100%);
}

.hero-warn {
  background: linear-gradient(140deg, var(--danger-soft) 0%, var(--peach-soft) 100%);
}

.hero-ok {
  background: linear-gradient(140deg, var(--ok-soft) 0%, var(--ok-soft) 100%);
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-face {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.hero-id {
  flex: 1;
}

.hero-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.hero-age {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.hero-chip {
  font-size: 22rpx;
  color: var(--text-2);
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.hero-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.65;
}

.hero-meta {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}

.hero-meta-item {
  font-size: 22rpx;
  color: var(--text-3);
  background: rgba(255, 255, 255, 0.6);
  border-radius: 10rpx;
  padding: 6rpx 14rpx;
}

/* ---------- 空状态 ---------- */
.empty-desc {
  font-size: 24rpx;
  line-height: 1.7;
  margin: 10rpx 0 20rpx;
}

.empty-btn {
  display: inline-block;
}

/* ---------- 未到月龄 ---------- */
.ready-card {
  background: var(--info-soft);
}

.ready-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 8rpx 0;
}

.ready-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--sleep-light);
  margin-top: 14rpx;
  flex-shrink: 0;
}

.ready-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.65;
}

.ready-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--sleep-muted);
  background: rgba(255, 255, 255, 0.7);
  border-radius: 14rpx;
  padding: 16rpx;
  line-height: 1.65;
}

/* ---------- 正在排敏 ---------- */
.watch-card {
  background: var(--bg);
  border: 2rpx solid var(--amber-soft);
}

.watch-badge {
  font-size: 22rpx;
  color: var(--warn);
  background: var(--warn-soft);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.watch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.watch-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--card);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.watch-body {
  flex: 1;
}

.watch-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.watch-sub {
  font-size: 22rpx;
  color: var(--olive);
  margin-top: 4rpx;
  line-height: 1.6;
}

.conflict {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  background: var(--danger-soft);
  color: var(--danger);
  font-size: 22rpx;
  line-height: 1.65;
  border-radius: 14rpx;
}

/* ---------- 今天吃什么 ---------- */
.today-label {
  font-size: 22rpx;
  color: var(--text-4);
  margin: -8rpx 0 14rpx 4rpx;
}

.meal-card {
  padding: 12rpx 32rpx 22rpx;
}

.meal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.meal-row:last-of-type {
  border-bottom: none;
}

.meal-slot {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-4);
}

.meal-body {
  flex: 1;
}

.meal-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
}

.meal-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.meal-new {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--warn);
  background: var(--warn-soft);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  display: inline-block;
}

.meal-swap {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.meal-foot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-5);
  text-align: center;
}

/* ---------- 一周餐单 ---------- */
.week-note {
  font-size: 22rpx;
  color: var(--olive);
  background: var(--bg);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.week-row {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.week-row:last-child {
  border-bottom: none;
}

.week-row-on {
  background: var(--bg);
  border-radius: 16rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.week-day {
  width: 92rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
}

.week-weekday {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text);
}

.week-date {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 2rpx;
}

.week-meals {
  flex: 1;
}

.week-meal {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  padding: 4rpx 0;
}

.week-meal-slot {
  font-size: 22rpx;
  color: var(--text-4);
  width: 56rpx;
  flex-shrink: 0;
}

.week-meal-name {
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.5;
}

/* ---------- 待尝试 ---------- */
.due-row {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--sunken-2);
}

.due-row:last-child {
  border-bottom: none;
}

.due-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 0;
}

.due-body {
  flex: 1;
}

.due-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

.due-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.due-tag {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 3rpx 10rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.due-tag-iron {
  color: var(--danger-text);
  background: var(--danger-soft);
}

.due-tag-allergen {
  color: var(--warn);
  background: var(--warn-soft);
}

.due-tag-custom {
  color: var(--sleep-muted);
  background: var(--sleep-soft);
}

.due-arrow {
  font-size: 30rpx;
  color: var(--line-strong);
}

.due-skip {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-4);
  padding: 10rpx 0 10rpx 18rpx;
}

.calm-card {
  background: var(--ok-soft);
}

.calm-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ok);
}

.calm-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--sage);
  line-height: 1.65;
}

/* ---------- 阶段要点 ---------- */
.stage-badge {
  display: inline-block;
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--bg);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 14rpx;
}

.kv {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.kv-key {
  width: 100rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-4);
}

.kv-val {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.65;
}

.mini-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-2);
  margin: 12rpx 0 8rpx;
}

.mini-item {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.75;
}

.avoid-item {
  color: var(--cocoa);
}

/* ---------- 已尝试 ---------- */
.rec-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.rec-row:last-of-type {
  border-bottom: none;
}

.rec-body {
  flex: 1;
  min-width: 0;
}

.rec-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

.rec-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 5rpx;
  line-height: 1.55;
}

.rec-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--sunken);
  border-radius: 10rpx;
  padding: 8rpx 12rpx;
  line-height: 1.5;
}

.rec-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.rec-tag {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 5rpx 14rpx;
}

.tag-ok {
  background: var(--ok-soft);
  color: var(--ok);
}

.tag-watch {
  background: var(--warn-soft);
  color: var(--warn);
}

.tag-warn {
  background: var(--danger-soft);
  color: var(--danger);
}

.tag-danger {
  background: var(--danger);
  color: var(--danger-soft);
}

.rec-group {
  font-size: 22rpx;
  color: var(--text-5);
}

.rec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
}

.rec-foot-text {
  font-size: 22rpx;
  color: var(--text-4);
}

.rec-toggle {
  font-size: 22rpx;
  color: var(--brand-deep);
}

/* ---------- 过敏原 ---------- */
.allergen-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.allergen-row:last-child {
  border-bottom: none;
}

.allergen-emoji {
  width: 48rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  line-height: 1.5;
}

.allergen-body {
  flex: 1;
}

.allergen-name {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-3);
}

.allergen-done {
  color: var(--ok);
}

.allergen-tip {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  margin-top: 4rpx;
}

/* ---------- 食材库 ---------- */
.lib-group {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-3);
  margin: 18rpx 0 10rpx;
}

.lib-group:first-child {
  margin-top: 0;
}

.lib-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.lib-item {
  width: calc((100% - 24rpx) / 3);
  padding: 14rpx 8rpx;
  background: var(--sunken);
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lib-name {
  font-size: 22rpx;
  color: var(--text);
  text-align: center;
  line-height: 1.3;
}

.lib-flag {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.flag-ok {
  color: var(--ok);
}

.flag-watch {
  color: var(--warn);
}

.flag-bad {
  color: var(--danger);
}

.flag-mute {
  color: var(--text-4);
}

.flag-due {
  color: var(--brand-deep);
}

.add-btn {
  margin-top: 12rpx;
}

/* ---------- 食谱浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.sheet-emoji {
  font-size: 40rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.sheet-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

.sheet-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.sheet-food {
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--bg);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.sheet-step {
  display: flex;
  gap: 12rpx;
  padding: 8rpx 0;
}

.sheet-step-no {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 20rpx; /* 圆形徽标里的字形，不是正文，豁免最小字号 */
  text-align: center;
  line-height: 34rpx;
  margin-top: 4rpx;
}

.sheet-step-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.7;
}

.sheet-tip {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: var(--bg);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--olive);
  line-height: 1.7;
}

.sheet-close {
  margin-top: 28rpx;
}

/* ---------- 逐月重点 ---------- */
/* 待尝试列表上方的月份提示 */
.due-month {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 0 8rpx 14rpx;
}

.due-month-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-deep);
}

.due-month-sub {
  font-size: 22rpx;
  color: var(--text-4);
}

/* 阶段卡里的本月重点 */
.focus-box {
  margin: 6rpx 0 14rpx;
  padding: 20rpx 22rpx;
  background: linear-gradient(135deg, var(--bg) 0%, var(--brand-tint) 100%);
  border-radius: 20rpx;
  border-left: 6rpx solid var(--apricot);
}

.focus-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-deep);
  margin-bottom: 8rpx;
}

.focus-text {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.focus-key {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--cocoa);
  line-height: 1.6;
}

.focus-key::before {
  content: '· ';
  color: var(--apricot);
  font-weight: 700;
}

.focus-next {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--amber);
}

.focus-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
}

/* ---------- 接种期就餐约束 ---------- */
.diet-bar {
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid var(--warn-strong);
  background: linear-gradient(135deg, var(--warn-soft) 0%, var(--warn-soft) 100%);
}

.diet-strict {
  border-left-color: var(--brand-strong);
  background: linear-gradient(135deg, var(--danger-soft) 0%, var(--danger-soft) 100%);
}

.diet-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--warn-text);
  margin-bottom: 8rpx;
}

.diet-strict .diet-title {
  color: var(--danger-text);
}

.diet-desc {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.diet-strict .diet-desc {
  color: var(--cocoa);
}

.diet-foot {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

/* ---------- 今天吃什么：理由与打卡 ---------- */
.meal-reason {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.meal-log {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ok);
  background: var(--ok-soft);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---------- 接着两天 ---------- */
.plan-card {
  padding: 8rpx 32rpx 20rpx;
}

.plan-day {
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--line);
}

.plan-day:last-child {
  border-bottom: none;
}

.plan-day-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.plan-day-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

.plan-day-date {
  font-size: 22rpx;
  color: var(--text-4);
}

.plan-meal {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.plan-meal-slot {
  width: 72rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-4);
}

.plan-meal-body {
  flex: 1;
}

.plan-meal-name {
  font-size: 24rpx;
  color: var(--text);
}

.plan-meal-reason {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 2rpx;
}

.plan-meal-log {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--ok);
  background: var(--ok-soft);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

/* ---------- 最近吃了什么 ---------- */
.log-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.log-row:last-of-type {
  border-bottom: none;
}

.log-body {
  flex: 1;
}

.log-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
}

.log-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-4);
}

.log-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.log-arrow {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--line-strong);
}

.log-foot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-5);
  text-align: center;
}

/* ---------- 吃过但没记排敏 ---------- */
.tip-bar {
  background: linear-gradient(135deg, var(--warn-soft) 0%, var(--warn-soft) 100%);
  border-left: 6rpx solid var(--warn-strong);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--warn-text);
}

.tip-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--olive);
  line-height: 1.65;
}

.tip-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.tip-chip {
  font-size: 22rpx;
  color: var(--brand-deep);
  background: var(--card);
  border: 2rpx solid var(--amber-soft);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

/* ---------- 当季一行 ---------- */
.season-line {
  margin: 6rpx 0 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
  background: var(--sunken);
  border-radius: 14rpx;
  padding: 12rpx 16rpx;
}

/* ---------- 食材库「吃过」标记 ---------- */
.lib-eaten {
  font-size: 22rpx;
  color: var(--mint);
  margin-top: 2rpx;
}

/* ---------- 底部双按钮 ---------- */
.act-row {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.act-btn {
  flex: 1;
}
