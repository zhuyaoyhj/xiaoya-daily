/* pages/food-edit/food-edit.wxss —— 记录一次辅食尝试 */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.top-tip {
  font-size: 24rpx;
  color: #A08D7D;
  padding: 8rpx 4rpx 20rpx;
}

/* ---------- 观察中提示 ---------- */
.watch-tip {
  background: #FDF4E3;
  border-left: 6rpx solid #E0B15C;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.watch-tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #8F6A1E;
  margin-bottom: 6rpx;
}

.watch-tip-desc {
  display: block;
  font-size: 23rpx;
  color: #9A8355;
  line-height: 1.6;
}

/* ---------- 分组 tab ---------- */
.gtabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.gtab {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  font-size: 25rpx;
  color: #8C7B6E;
  background: #FFFFFF;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.gtab-on {
  color: #C4643F;
  background: #FFEDE4;
  border-color: #F5C4A8;
  font-weight: 600;
}

/* ---------- 食材网格 ---------- */
.pick-name {
  font-size: 22rpx;
  color: #B3A195;
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.food-item {
  width: calc((100% - 28rpx) / 3);
  min-height: 112rpx;
  padding: 18rpx 10rpx 16rpx;
  background: #FDF9F4;
  border: 2rpx solid #F2E7DA;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.15s;
}

.food-item-on {
  background: #FFF0E7;
  border-color: #F0876B;
  box-shadow: 0 6rpx 16rpx rgba(240, 135, 107, 0.18);
}

.food-name {
  font-size: 26rpx;
  color: #3A2E26;
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.food-item-on .food-name {
  color: #C4643F;
  font-weight: 600;
}

.food-meta {
  font-size: 20rpx;
  color: #B3A195;
  margin-top: 8rpx;
}

.food-meta-bad {
  color: #C43C2A;
}

.food-custom {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: #A88FC4;
  background: #F2ECFA;
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.food-item-add .food-name {
  color: #B3A195;
}

.food-item-add .food-meta {
  color: #C9B8A8;
}

.empty-hint {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #B3A195;
  text-align: center;
}

.food-badge-iron {
  font-size: 20rpx;
  color: #B4553F;
  background: #FFEDE6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* ---------- 关键值行 ---------- */
.kv {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.kv:last-child {
  border-bottom: none;
}

.kv-key {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8C7B6E;
}

.kv-val {
  flex: 1;
  font-size: 24rpx;
  color: #3A2E26;
  line-height: 1.65;
}

.kv-last {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #A08D7D;
  background: #FBF6F0;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

/* ---------- 反应选择 ---------- */
.rxn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.rxn-chip {
  flex: 1;
  min-width: 45%;
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.rxn-ok {
  background: #EAF3EC;
  color: #4B7C5C;
}

.rxn-watch {
  background: #FDF1DC;
  color: #A97A22;
}

.rxn-warn {
  background: #FFE7E3;
  color: #C43C2A;
}

.rxn-danger {
  background: #FBE0DC;
  color: #B02A1C;
}

.rxn-chip-on {
  border-color: currentColor;
  font-weight: 600;
  transform: translateY(-1rpx);
  box-shadow: 0 6rpx 14rpx rgba(180, 120, 90, 0.16);
}

.rxn-detail {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #FBF6F0;
  border-radius: 16rpx;
}

.rxn-desc {
  font-size: 24rpx;
  color: #3A2E26;
  line-height: 1.6;
}

.rxn-next {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8C7B6E;
  line-height: 1.6;
}

.rxn-alert {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: #B02A1C;
  color: #FFF3F0;
  font-size: 24rpx;
  line-height: 1.65;
  border-radius: 16rpx;
}

.note-area {
  width: 100%;
  min-height: 130rpx;
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #3A2E26;
  line-height: 1.6;
}

/* ---------- 日期 ---------- */
.time-hint {
  font-size: 21rpx;
  color: #B3A195;
  line-height: 1.6;
  padding: 10rpx 0 12rpx;
}

/* ---------- 底部按钮 ---------- */
.save-btn {
  margin-top: 8rpx;
}

.save-btn-off {
  opacity: 0.45;
}

.del-btn {
  margin-top: 20rpx;
  color: #C43C2A;
}

/* ---------- 自定义食材浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: #FFFDFB;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A2E26;
  margin-bottom: 24rpx;
}

.sheet-label {
  font-size: 23rpx;
  color: #8C7B6E;
  margin: 20rpx 0 12rpx;
}

.sheet-input {
  width: 100%;
  height: 76rpx;
  background: #FBF6F0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #3A2E26;
}

.sheet-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sheet-chip {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #8C7B6E;
  background: #FBF6F0;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}

.sheet-chip-on {
  color: #C4643F;
  background: #FFEDE4;
  border-color: #F5C4A8;
  font-weight: 600;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-actions .btn {
  flex: 1;
}

.custom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F6ECE2;
}

.custom-name {
  font-size: 25rpx;
  color: #3A2E26;
}

.custom-del {
  font-size: 23rpx;
  color: #C43C2A;
  padding: 4rpx 12rpx;
}
