/* pages/food-edit/food-edit.wxss —— 记录一次辅食尝试 */

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.top-tip {
  font-size: 24rpx;
  color: var(--text-4);
  padding: 8rpx 4rpx 20rpx;
}

/* ---------- 观察中提示 ---------- */
.watch-tip {
  background: var(--warn-soft);
  border-left: 6rpx solid var(--warn-strong);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.watch-tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--warn-text);
  margin-bottom: 6rpx;
}

.watch-tip-desc {
  display: block;
  font-size: 22rpx;
  color: var(--olive);
  line-height: 1.6;
}

/* ---------- 分组 tab ---------- */
.gtabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.gtab {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  margin-right: 12rpx;
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--card);
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.gtab-on {
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-color: var(--brand-soft);
  font-weight: 600;
}

/* ---------- 食材网格 ---------- */
.pick-name {
  font-size: 22rpx;
  color: var(--text-4);
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.food-item {
  width: calc((100% - 28rpx) / 3);
  min-height: 112rpx;
  padding: 18rpx 10rpx 16rpx;
  background: var(--sunken);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.15s;
}

.food-item-on {
  background: var(--brand-tint);
  border-color: var(--brand);
  box-shadow: 0 6rpx 16rpx rgba(240, 135, 107, 0.18);
}

.food-name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
  text-align: center;
  line-height: 1.3;
}

.food-item-on .food-name {
  color: var(--brand-deep);
  font-weight: 600;
}

.food-meta {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 8rpx;
}

.food-meta-bad {
  color: var(--danger);
}

.food-custom {
  position: absolute;
  top: 6rpx;
  right: 8rpx;
  font-size: 22rpx;
  color: var(--sleep-light);
  background: var(--sleep-soft);
  border-radius: 8rpx;
  padding: 2rpx 8rpx;
}

.food-item-add .food-name {
  color: var(--text-4);
}

.food-item-add .food-meta {
  color: var(--text-5);
}

.empty-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-4);
  text-align: center;
}

.food-badge-iron {
  font-size: 22rpx;
  color: var(--danger-text);
  background: var(--danger-soft);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

/* ---------- 关键值行 ---------- */
.kv {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.kv:last-child {
  border-bottom: none;
}

.kv-key {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
}

.kv-val {
  flex: 1;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.65;
}

.kv-last {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-4);
  background: var(--sunken);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

/* ---------- 反应选择 ---------- */
.rxn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.rxn-chip {
  flex: 1;
  min-width: 45%;
  text-align: center;
  padding: 18rpx 10rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.rxn-ok {
  background: var(--ok-soft);
  color: var(--ok);
}

.rxn-watch {
  background: var(--warn-soft);
  color: var(--warn);
}

.rxn-warn {
  background: var(--danger-soft);
  color: var(--danger);
}

.rxn-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.rxn-chip-on {
  border-color: currentColor;
  font-weight: 600;
  transform: translateY(-1rpx);
  box-shadow: 0 6rpx 14rpx rgba(180, 120, 90, 0.16);
}

.rxn-detail {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--sunken);
  border-radius: 16rpx;
}

.rxn-desc {
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

.rxn-next {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.6;
}

.rxn-alert {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: var(--danger);
  color: var(--danger-soft);
  font-size: 24rpx;
  line-height: 1.65;
  border-radius: 16rpx;
}

.note-area {
  width: 100%;
  min-height: 130rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ---------- 日期 ---------- */
.time-hint {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.6;
  padding: 10rpx 0 12rpx;
}

/* ---------- 底部按钮 ---------- */
.save-btn {
  margin-top: 8rpx;
}

.save-btn-off {
  opacity: 0.45;
}

.del-btn {
  margin-top: 20rpx;
  color: var(--danger);
}

/* ---------- 自定义食材浮层 ---------- */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.45);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 24rpx;
}

.sheet-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin: 20rpx 0 12rpx;
}

.sheet-input {
  width: 100%;
  height: 76rpx;
  background: var(--sunken);
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text);
}

.sheet-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.sheet-chip {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-3);
  background: var(--sunken);
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}

.sheet-chip-on {
  color: var(--brand-deep);
  background: var(--brand-tint);
  border-color: var(--brand-soft);
  font-weight: 600;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.sheet-actions .btn {
  flex: 1;
}

.custom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--sunken-2);
}

.custom-name {
  font-size: 24rpx;
  color: var(--text);
}

.custom-del {
  font-size: 22rpx;
  color: var(--danger);
  padding: 4rpx 12rpx;
}
