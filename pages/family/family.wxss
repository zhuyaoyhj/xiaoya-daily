/* pages/family/family.wxss */

.list-card {
  padding: 10rpx 28rpx;
}

.member {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F7EFE7;
}

.member:last-child {
  border-bottom: none;
}

.member-check {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  border: 3rpx solid #E6D6C7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.member-check-on {
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  border-color: #F0876B;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A2E26;
}

.member-rel {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 4rpx;
}

.member-del {
  font-size: 24rpx;
  color: #C0AFA1;
  padding: 10rpx 0 10rpx 20rpx;
}

/* ---------- 空状态 ---------- */
.empty-card {
  text-align: center;
  padding: 46rpx 40rpx;
}

.empty-desc {
  margin-top: 12rpx;
  line-height: 1.7;
}

/* ---------- 添加 ---------- */
.add-row {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  background: #F8F2EB;
  border-radius: 24rpx;
  padding: 0 12rpx 0 26rpx;
  height: 88rpx;
}

.add-input {
  flex: 1;
  font-size: 28rpx;
  color: #3A2E26;
  height: 88rpx;
}

.add-relation {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 31rpx;
  background: #FFFFFF;
  color: #C9694A;
  font-size: 25rpx;
}

.add-btn {
  margin-top: 22rpx;
}

/* ---------- 说明 ---------- */
.how-card {
  background: linear-gradient(140deg, #FFFFFF 0%, #FFF7F0 100%);
}

.how-item {
  display: flex;
  align-items: flex-start;
  margin-top: 26rpx;
}

.how-step {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFEBDD;
  color: #D9724F;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 44rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.how-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2E26;
}

.how-desc {
  font-size: 23rpx;
  color: #96867A;
  line-height: 1.65;
  margin-top: 6rpx;
}

/* ---------- 订阅 ---------- */
.sub-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 26rpx;
  border-top: 2rpx dashed #EFE2D4;
}

.sub-info {
  flex: 1;
  padding-right: 20rpx;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2E26;
}

.sub-desc {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 6rpx;
}

.sub-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.sub-btn-off {
  background: #F3EDE6;
  color: #9A8B7D;
}

.copy-btn {
  margin-top: 20rpx;
}
