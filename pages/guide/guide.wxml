<view class="page-wrap">

  <!-- 月龄切换 -->
  <view class="month-bar">
    <view class="month-nav" bindtap="prevMonth">‹</view>
    <view class="month-center">
      <view class="month-label">{{label}}</view>
      <view class="month-tag">{{tag}}</view>
    </view>
    <view class="month-nav" bindtap="nextMonth">›</view>
  </view>

  <view class="month-hint" wx:if="{{!isCurrent}}" bindtap="backToCurrent">
    这是第 {{month}} 个月的参考，点这里回到{{babyName || '宝宝'}}当前月龄（{{currentMonth}} 个月）
  </view>
  <view class="month-hint" wx:else>左右箭头可以看前后月龄，提前准备不慌张</view>

  <!-- 分类 tab -->
  <scroll-view class="tab-bar" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      class="tab {{tab === item.key ? 'tab-on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      <text class="tab-emoji">{{item.emoji}}</text>{{item.title}}
    </view>
  </scroll-view>

  <!-- 辅食专区（只在「吃」tab 出现） -->
  <view class="food-entry entry-{{foodCard.tone}}" wx:if="{{tab === 'eat' && foodCard}}" bindtap="goFood">
    <view class="entry-top">
      <view class="entry-badge">辅食</view>
      <view class="entry-chip">{{foodCard.stageLabel}}</view>
    </view>
    <view class="entry-title">{{foodCard.title}}</view>
    <view class="entry-month" wx:if="{{foodCard.focusTitle}}">{{foodCard.focusTitle}}</view>
    <view class="entry-desc">{{foodCard.desc}}</view>
    <view class="entry-today" wx:if="{{foodCard.todayText}}">今天这顿：{{foodCard.todayText}}</view>
    <view class="entry-go">打开辅食喂养 · 已试 {{foodCard.tried}} 种 ›</view>
  </view>

  <!-- 内容 -->
  <view class="sec" wx:for="{{visible}}" wx:key="key">
    <view class="sec-head">
      <view class="sec-emoji" style="background:{{item.soft}};color:{{item.color}}">{{item.emoji}}</view>
      <view class="sec-head-text">
        <view class="sec-title">{{item.title}}</view>
        <view class="sec-heading">{{item.heading}}</view>
      </view>
    </view>

    <view class="card sec-card">
      <view class="li" wx:for="{{item.rows}}" wx:for-item="row" wx:key="k">
        <view class="li-dot" style="background:{{item.color}}"></view>
        <view class="li-text">{{row.t}}</view>
      </view>
    </view>
  </view>

  <button class="btn btn-primary btn-block share-btn" bindtap="goShare">把这份建议发给家人</button>

  <disclaimer />
</view>
