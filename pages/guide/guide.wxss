/* pages/guide/guide.wxss */

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 12rpx;
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--line) 100%);
  border-radius: 36rpx;
  padding: 26rpx 20rpx;
  box-shadow: 0 12rpx 30rpx var(--shadow-strong);
}

.month-nav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--glass-strong);
  color: var(--brand-strong);
  font-size: 44rpx;
  line-height: 66rpx;
  text-align: center;
  flex-shrink: 0;
}

.month-center {
  flex: 1;
  text-align: center;
}

.month-label {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--shade);
}

.month-tag {
  font-size: 24rpx;
  color: var(--text-warm);
  margin-top: 6rpx;
}

.month-hint {
  font-size: 24rpx;
  color: var(--text-warm);
  text-align: center;
  padding: 8rpx 20rpx 22rpx;
  line-height: 1.6;
}

.tab-bar {
  display: flex;
  white-space: nowrap;
  margin-bottom: 26rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.tab-on {
  background: linear-gradient(135deg, var(--brand-light) 0%, var(--brand) 100%);
  color: var(--on-brand);
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(240, 135, 107, 0.3);
}

.tab-emoji {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.sec {
  margin-bottom: 32rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.sec-emoji {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}

.sec-head-text {
  flex: 1;
  min-width: 0;
}

.sec-title {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.sec-heading {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 2rpx;
  line-height: 1.4;
}

.sec-card {
  padding: 28rpx 30rpx 20rpx;
}

/* 主建议：放大一号，左侧色条，扫一眼就能抓住 */
.lead {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.6;
  padding-left: 20rpx;
  border-left: 6rpx solid var(--brand);
  margin-bottom: 18rpx;
}

.li {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.li-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin: 18rpx 18rpx 0 8rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.li-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.65;
}

.more {
  font-size: 24rpx;
  color: var(--brand);
  text-align: center;
  padding: 16rpx 0 4rpx;
  border-top: 2rpx dashed var(--line);
  margin-top: 10rpx;
}

.share-btn {
  margin: 28rpx 0 8rpx;
}

/* ---------- 辅食专区入口（吃 tab 顶部） ---------- */
.food-entry {
  background: linear-gradient(140deg, var(--brand-tint) 0%, var(--line) 100%);
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 26rpx var(--shadow);
}

.entry-pre {
  background: linear-gradient(140deg, var(--info-soft) 0%, var(--sleep-soft) 100%);
}

.entry-watch {
  background: linear-gradient(140deg, var(--warn-soft) 0%, var(--amber-soft) 100%);
}

.entry-warn {
  background: linear-gradient(140deg, var(--danger-soft) 0%, var(--peach-soft) 100%);
}

.entry-ok {
  background: linear-gradient(140deg, var(--ok-soft) 0%, var(--ok-soft) 100%);
}

.entry-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.entry-badge {
  font-size: 22rpx;
  color: var(--on-brand);
  background: var(--brand);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.entry-chip {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--glass-strong);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.45;
}

.entry-month {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand-deep);
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.entry-today {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--cocoa);
  background: var(--glass-strong);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.entry-go {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--brand-deep);
  font-weight: 500;
}

/* ---------- 月龄段切换 ---------- */
.month-nav-off {
  opacity: 0.35;
}

.month-now {
  color: var(--brand-strong);
  font-weight: 600;
}

.seg-bar {
  display: flex;
  white-space: nowrap;
  margin: 4rpx 0 8rpx;
}

.seg {
  display: inline-block;
  font-size: 24rpx;
  color: var(--text-warm);
  padding: 8rpx 20rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: var(--glass-strong);
}

.seg-on {
  color: var(--on-brand);
  background: var(--brand);
  font-weight: 600;
}

.month-hint-link {
  color: var(--brand-strong);
}

/* ---------- 本段要点 ---------- */
.digest {
  padding: 28rpx 30rpx 12rpx;
  margin-bottom: 28rpx;
}

.digest-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8rpx;
}

.digest-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid var(--sunken-2);
}

.digest-row:first-of-type {
  border-top: none;
}

.digest-row:active {
  opacity: 0.7;
}

.digest-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.digest-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.5;
}

.digest-go {
  font-size: 32rpx;
  color: var(--text-5);
}

/* ---------- 要留意 ---------- */
.alert-card {
  background: var(--warn-soft);
  border: 2rpx solid var(--amber-soft);
  border-radius: 28rpx;
  padding: 26rpx 30rpx 16rpx;
  margin-bottom: 28rpx;
}

.alert-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--warn-text);
  margin-bottom: 8rpx;
}

.alert-li {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.alert-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--warn-strong);
  margin: 18rpx 18rpx 0 6rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.65;
}

/* ---------- 下一阶段 ---------- */
.next-card {
  background: var(--card);
  border: 2rpx dashed var(--line-strong);
  border-radius: 28rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 32rpx;
}

.next-card:active {
  opacity: 0.8;
}

.next-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.next-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--info);
  background: var(--info-soft);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.next-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.next-point {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.next-go {
  font-size: 24rpx;
  color: var(--brand);
  margin-top: 10rpx;
}
