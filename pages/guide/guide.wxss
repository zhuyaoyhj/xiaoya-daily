/* pages/guide/guide.wxss */

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 12rpx;
  background: linear-gradient(140deg, #FFF2E6 0%, #FFE5D6 100%);
  border-radius: 36rpx;
  padding: 26rpx 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(226, 168, 132, 0.18);
}

.month-nav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  color: #D9724F;
  font-size: 44rpx;
  line-height: 66rpx;
  text-align: center;
  flex-shrink: 0;
}

.month-center {
  flex: 1;
  text-align: center;
}

.month-label {
  font-size: 38rpx;
  font-weight: 700;
  color: #40301F;
}

.month-tag {
  font-size: 24rpx;
  color: #A5836C;
  margin-top: 6rpx;
}

.month-hint {
  font-size: 22rpx;
  color: #A5836C;
  text-align: center;
  padding: 8rpx 20rpx 22rpx;
  line-height: 1.6;
}

.tab-bar {
  display: flex;
  white-space: nowrap;
  margin-bottom: 26rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #7A6759;
  font-size: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(213, 176, 147, 0.12);
}

.tab-on {
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(240, 135, 107, 0.3);
}

.tab-emoji {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.sec {
  margin-bottom: 12rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  padding: 14rpx 6rpx 18rpx;
}

.sec-emoji {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.sec-title {
  font-size: 26rpx;
  color: #A5836C;
}

.sec-heading {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A2E26;
  margin-top: 2rpx;
  line-height: 1.45;
}

.sec-card {
  padding: 10rpx 32rpx;
}

.li {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F7EFE7;
}

.li:last-child {
  border-bottom: none;
}

.li-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 16rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.li-text {
  flex: 1;
  font-size: 28rpx;
  color: #4A3E34;
  line-height: 1.7;
}

.share-btn {
  margin: 28rpx 0 8rpx;
}

/* ---------- 辅食专区入口（吃 tab 顶部） ---------- */
.food-entry {
  background: linear-gradient(140deg, #FFF3E9 0%, #FFE7D6 100%);
  border-radius: 28rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(213, 176, 147, 0.16);
}

.entry-pre {
  background: linear-gradient(140deg, #F4F2FB 0%, #E9E4F4 100%);
}

.entry-watch {
  background: linear-gradient(140deg, #FDF4E3 0%, #F8E7C8 100%);
}

.entry-warn {
  background: linear-gradient(140deg, #FFEFEA 0%, #FBDCD2 100%);
}

.entry-ok {
  background: linear-gradient(140deg, #EFF6EF 0%, #DFEEDF 100%);
}

.entry-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.entry-badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #F0876B;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.entry-chip {
  font-size: 20rpx;
  color: #8C7B6E;
  background: rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3A2E26;
  line-height: 1.45;
}

.entry-month {
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #C4703C;
}

.entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7A6A5C;
  line-height: 1.6;
}

.entry-today {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #9A6A4C;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
}

.entry-go {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #C4643F;
  font-weight: 500;
}
