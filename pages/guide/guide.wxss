/* pages/guide/guide.wxss */

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 12rpx;
  background: linear-gradient(140deg, #FFF2E6 0%, #FFE5D6 100%);
  border-radius: 36rpx;
  padding: 26rpx 20rpx;
  box-shadow: 0 12rpx 30rpx rgba(226, 168, 132, 0.18);
}

.month-nav {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.78);
  color: #D9724F;
  font-size: 44rpx;
  line-height: 66rpx;
  text-align: center;
  flex-shrink: 0;
}

.month-center {
  flex: 1;
  text-align: center;
}

.month-label {
  font-size: 38rpx;
  font-weight: 700;
  color: #40301F;
}

.month-tag {
  font-size: 24rpx;
  color: #A5836C;
  margin-top: 6rpx;
}

.month-hint {
  font-size: 22rpx;
  color: #A5836C;
  text-align: center;
  padding: 8rpx 20rpx 22rpx;
  line-height: 1.6;
}

.tab-bar {
  display: flex;
  white-space: nowrap;
  margin-bottom: 26rpx;
}

.tab {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #7A6759;
  font-size: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(213, 176, 147, 0.12);
}

.tab-on {
  background: linear-gradient(135deg, #FFA07E 0%, #F0876B 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 10rpx 22rpx rgba(240, 135, 107, 0.3);
}

.tab-emoji {
  margin-right: 8rpx;
  font-size: 26rpx;
}

.sec {
  margin-bottom: 12rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  padding: 14rpx 6rpx 18rpx;
}

.sec-emoji {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.sec-title {
  font-size: 26rpx;
  color: #A5836C;
}

.sec-heading {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A2E26;
  margin-top: 2rpx;
  line-height: 1.45;
}

.sec-card {
  padding: 10rpx 32rpx;
}

.li {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F7EFE7;
}

.li:last-child {
  border-bottom: none;
}

.li-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 16rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  opacity: 0.85;
}

.li-text {
  flex: 1;
  font-size: 28rpx;
  color: #4A3E34;
  line-height: 1.7;
}

.share-btn {
  margin: 28rpx 0 8rpx;
}
