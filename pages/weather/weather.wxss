/* pages/weather/weather.wxss */

.city-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 6rpx 18rpx;
}

.city-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.city-pin {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.place-text {
  flex: 1;
  min-width: 0;
}

.city-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A2E26;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-sub {
  font-size: 20rpx;
  color: #A8968A;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-arrow {
  font-size: 22rpx;
  color: #B2886F;
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  background: #FFF1E6;
  border-radius: 20rpx;
}

.city-refresh {
  font-size: 24rpx;
  color: #B2886F;
}

/* ---------- 状态卡 ---------- */
.state-card {
  text-align: center;
  padding: 56rpx 40rpx;
}

.state-emoji {
  font-size: 72rpx;
  line-height: 1.3;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2E26;
  margin-top: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: #8C7B6E;
  line-height: 1.7;
  margin: 14rpx 0 32rpx;
}

/* ---------- 天气主卡 ---------- */
.main-card {
  background: linear-gradient(145deg, #FFF4E9 0%, #FFE6D7 55%, #FFD9C4 100%);
  box-shadow: 0 16rpx 36rpx rgba(226, 168, 132, 0.2);
}

.main-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.main-temp {
  font-size: 96rpx;
  font-weight: 700;
  color: #40301F;
  line-height: 1.05;
  letter-spacing: -2rpx;
}

.main-text {
  font-size: 26rpx;
  color: #8A6C55;
  margin-top: 10rpx;
}

.main-place {
  display: flex;
  align-items: center;
  font-size: 21rpx;
  color: #8A6C55;
  margin-top: 16rpx;
}

.main-place-pin {
  margin-right: 6rpx;
  font-size: 20rpx;
}

.main-stale {
  margin-left: 12rpx;
  font-size: 18rpx;
  color: #B4743F;
  background: #FFF7EC;
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
}

.main-right {
  text-align: right;
  padding-top: 12rpx;
}

.main-range {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B4C38;
  margin-top: 6rpx;
}

.metrics {
  display: flex;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 22rpx 12rpx;
  background: rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A3627;
}

.metric-key {
  font-size: 20rpx;
  color: #A5836C;
  margin-top: 4rpx;
}

.main-updated {
  font-size: 20rpx;
  color: #B29A86;
  text-align: right;
  margin-top: 16rpx;
}

/* ---------- 卡片通用 ---------- */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A2E26;
}

.level-tag {
  font-size: 22rpx;
  color: #E0795A;
  background: #FFF1E6;
  border-radius: 22rpx;
  padding: 6rpx 20rpx;
}

.sleep-tog {
  font-size: 22rpx;
  color: #7A6AA8;
  background: #F0EBFA;
  border-radius: 22rpx;
  padding: 6rpx 20rpx;
}

.advice-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #3A2E26;
  line-height: 1.6;
}

.advice-basis {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ---------- 分层 ---------- */
.layer {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F7EFE7;
}

.layer:last-of-type {
  border-bottom: none;
}

.layer-part {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #B2886F;
  padding-top: 4rpx;
}

.layer-body {
  flex: 1;
}

.layer-text {
  font-size: 28rpx;
  color: #4A3E34;
  font-weight: 600;
  line-height: 1.55;
}

.layer-tip {
  font-size: 22rpx;
  color: #A8968A;
  margin-top: 6rpx;
  line-height: 1.55;
}

.band-tip {
  font-size: 23rpx;
  color: #B4743F;
  background: #FFF7EC;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-top: 20rpx;
  line-height: 1.65;
}

/* ---------- 注意事项 ---------- */
.alert-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.alert-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #F0A78B;
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 27rpx;
  color: #4A3E34;
  line-height: 1.7;
}

/* ---------- 判断 ---------- */
.judge-card {
  background: linear-gradient(140deg, #FFFFFF 0%, #F4F8F5 100%);
}

.judge-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4F7A63;
}

.judge-text {
  font-size: 26rpx;
  color: #5E7A6B;
  line-height: 1.7;
  margin-top: 10rpx;
}

.share-btn {
  margin: 12rpx 0 8rpx;
}

/* ---------- 月龄阶段提示 ---------- */
.stage-line {
  font-size: 22rpx;
  color: #5E7A6B;
  background: #EDF6F0;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

/* ---------- 睡袋温度对照表 ---------- */
.room-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F7F3FB;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 6rpx;
}

.room-left {
  display: flex;
  align-items: baseline;
}

.room-key {
  font-size: 24rpx;
  color: #8C7B6E;
  margin-right: 12rpx;
}

.room-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #7A6AA8;
  letter-spacing: -1rpx;
}

.room-tag {
  font-size: 18rpx;
  color: #7A6AA8;
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}

.room-right {
  display: flex;
}

.room-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 34rpx;
  color: #7A6AA8;
  background: #FFFFFF;
  border-radius: 18rpx;
  margin-left: 14rpx;
}

.room-btn:active {
  background: #EDE6F7;
}

.room-hint {
  font-size: 20rpx;
  color: #A99A8C;
  margin-top: 12rpx;
  line-height: 1.6;
  display: flex;
  justify-content: space-between;
}

.room-reset {
  color: #7A6AA8;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sleep-style-note {
  font-size: 21rpx;
  color: #9A8AA8;
  margin-top: 8rpx;
  line-height: 1.6;
}

.sleep-head {
  font-size: 23rpx;
  color: #8C7B6E;
  margin-bottom: 16rpx;
}

.sleep-row {
  background: #FBF7F3;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.sleep-row-on {
  background: #F4F0FC;
  border-color: #D9CEF0;
}

.sleep-row-top {
  display: flex;
  align-items: center;
}

.sleep-range {
  font-size: 25rpx;
  font-weight: 700;
  color: #4A3E34;
}

.sleep-tog-sm {
  font-size: 21rpx;
  color: #7A6AA8;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
}

.sleep-now {
  font-size: 18rpx;
  color: #FFFFFF;
  background: #8E7BC0;
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
  margin-left: auto;
}

.sleep-text {
  font-size: 24rpx;
  color: #5C4E42;
  line-height: 1.6;
  margin-top: 8rpx;
}

.sleep-note {
  font-size: 20rpx;
  color: #A8968A;
  line-height: 1.55;
  margin-top: 4rpx;
}

/* ---------- 手动温度（天气兜底） ---------- */
.state-alt {
  margin-top: 20rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin: 20rpx auto 0;
  width: 80%;
  background: linear-gradient(90deg, #F5EBE1 25%, #FBF4EC 50%, #F5EBE1 75%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.skeleton-short {
  width: 50%;
}

@keyframes skeleton-shine {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

.manual-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.manual-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #FFF1E6;
  color: #D96B4F;
  font-weight: 600;
}

.manual-link {
  color: #F0876B;
}

.manual-entry {
  text-align: center;
  font-size: 24rpx;
  color: #A8968A;
  padding: 12rpx 0 4rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.42);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: #FFF8F0;
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A2E26;
}

.sheet-desc {
  font-size: 24rpx;
  color: #9A8A7C;
  line-height: 1.6;
  margin: 8rpx 0 28rpx;
}

.quick-grid {
  display: flex;
  gap: 14rpx;
}

.quick-item {
  flex: 1;
  background: #FFFFFF;
  border: 2rpx solid #F2E6DA;
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.quick-item:active {
  background: #FFF1E6;
  border-color: #F0876B;
}

.quick-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A2E26;
}

.quick-hint {
  font-size: 20rpx;
  color: #A8968A;
  margin-top: 4rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 28rpx;
  margin: 28rpx 0;
  border: 2rpx solid #F2E6DA;
}

.manual-input {
  flex: 1;
  height: 92rpx;
  font-size: 30rpx;
}

.manual-unit {
  font-size: 28rpx;
  color: #8C7B6E;
}
