/* pages/weather/weather.wxss */

.city-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 6rpx 18rpx;
}

.city-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.city-pin {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.place-text {
  flex: 1;
  min-width: 0;
}

.city-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-sub {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-arrow {
  font-size: 22rpx;
  color: var(--text-warm);
  margin-left: 14rpx;
  padding: 4rpx 14rpx;
  background: var(--brand-tint);
  border-radius: 20rpx;
}

.city-refresh {
  font-size: 24rpx;
  color: var(--text-warm);
}

/* ---------- 状态卡 ---------- */
.state-card {
  text-align: center;
  padding: 56rpx 40rpx;
}

.state-emoji {
  font-size: 72rpx;
  line-height: 1.3;
}

.state-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-top: 12rpx;
}

.state-desc {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin: 14rpx 0 32rpx;
}

/* ---------- 天气主卡 ---------- */
.main-card {
  background: linear-gradient(145deg, var(--brand-tint) 0%, var(--line) 55%, var(--peach-soft) 100%);
  box-shadow: 0 16rpx 36rpx rgba(226, 168, 132, 0.2);
}

.main-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.main-temp {
  font-size: 96rpx;
  font-weight: 700;
  color: var(--shade);
  line-height: 1.05;
  letter-spacing: -2rpx;
}

.main-text {
  font-size: 26rpx;
  color: var(--text-warm);
  margin-top: 10rpx;
}

.main-place {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-warm);
  margin-top: 16rpx;
}

.main-place-pin {
  margin-right: 6rpx;
  font-size: 22rpx;
}

.main-stale {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--amber);
  background: var(--bg);
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
}

.main-right {
  text-align: right;
  padding-top: 12rpx;
}

.main-range {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-top: 6rpx;
}

.metrics {
  display: flex;
  justify-content: space-between;
  margin-top: 34rpx;
  padding: 22rpx 12rpx;
  background: rgba(255, 255, 255, 0.62);
  border-radius: 24rpx;
}

.metric {
  flex: 1;
  text-align: center;
}

.metric-val {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--shade);
}

.metric-key {
  font-size: 22rpx;
  color: var(--text-warm);
  margin-top: 4rpx;
}

.main-updated {
  font-size: 22rpx;
  color: var(--text-4);
  text-align: right;
  margin-top: 16rpx;
}

/* ---------- 卡片通用 ---------- */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.level-tag {
  font-size: 22rpx;
  color: var(--brand-strong);
  background: var(--brand-tint);
  border-radius: 22rpx;
  padding: 6rpx 20rpx;
}

.sleep-tog {
  font-size: 22rpx;
  color: var(--sleep);
  background: var(--sleep-soft);
  border-radius: 22rpx;
  padding: 6rpx 20rpx;
}

.advice-main {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.6;
}

.advice-basis {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 10rpx;
  line-height: 1.6;
}

/* ---------- 分层 ---------- */
.layer {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--sunken-2);
}

.layer:last-of-type {
  border-bottom: none;
}

.layer-part {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-warm);
  padding-top: 4rpx;
}

.layer-body {
  flex: 1;
}

.layer-text {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  line-height: 1.55;
}

.layer-tip {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 6rpx;
  line-height: 1.55;
}

.band-tip {
  font-size: 22rpx;
  color: var(--amber);
  background: var(--bg);
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  margin-top: 20rpx;
  line-height: 1.65;
}

/* ---------- 注意事项 ---------- */
.alert-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.alert-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--brand-light);
  margin-top: 16rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.alert-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.7;
}

/* ---------- 判断 ---------- */
.judge-card {
  background: linear-gradient(140deg, var(--card) 0%, var(--card) 100%);
}

.judge-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ok);
}

.judge-text {
  font-size: 26rpx;
  color: var(--sage);
  line-height: 1.7;
  margin-top: 10rpx;
}

.share-btn {
  margin: 12rpx 0 8rpx;
}

/* ---------- 月龄阶段提示 ---------- */
.stage-line {
  font-size: 22rpx;
  color: var(--sage);
  background: var(--ok-soft);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
  margin-bottom: 18rpx;
}

/* ---------- 睡袋温度对照表 ---------- */
.room-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--info-soft);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-top: 6rpx;
}

.room-left {
  display: flex;
  align-items: baseline;
}

.room-key {
  font-size: 24rpx;
  color: var(--text-3);
  margin-right: 12rpx;
}

.room-val {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--sleep);
  letter-spacing: -1rpx;
}

.room-tag {
  font-size: 22rpx;
  color: var(--sleep);
  background: var(--card);
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
}

.room-right {
  display: flex;
}

.room-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--sleep);
  background: var(--card);
  border-radius: 18rpx;
  margin-left: 14rpx;
}

.room-btn:active {
  background: var(--sleep-soft);
}

.room-hint {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 12rpx;
  line-height: 1.6;
  display: flex;
  justify-content: space-between;
}

.room-reset {
  color: var(--sleep);
  margin-left: 16rpx;
  flex-shrink: 0;
}

.sleep-style-note {
  font-size: 22rpx;
  color: var(--sleep-muted);
  margin-top: 8rpx;
  line-height: 1.6;
}

.sleep-head {
  font-size: 22rpx;
  color: var(--text-3);
  margin-bottom: 16rpx;
}

.sleep-row {
  background: var(--sunken);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
}

.sleep-row-on {
  background: var(--sleep-soft);
  border-color: var(--sleep-line);
}

.sleep-row-top {
  display: flex;
  align-items: center;
}

.sleep-range {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text);
}

.sleep-tog-sm {
  font-size: 22rpx;
  color: var(--sleep);
  background: var(--card);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
}

.sleep-now {
  font-size: 22rpx;
  color: var(--card);
  background: var(--sleep);
  border-radius: 14rpx;
  padding: 2rpx 12rpx;
  margin-left: auto;
}

.sleep-text {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  margin-top: 8rpx;
}

.sleep-note {
  font-size: 22rpx;
  color: var(--text-4);
  line-height: 1.55;
  margin-top: 4rpx;
}

/* ---------- 手动温度（天气兜底） ---------- */
.state-alt {
  margin-top: 20rpx;
}

.skeleton-line {
  height: 24rpx;
  border-radius: 12rpx;
  margin: 20rpx auto 0;
  width: 80%;
  background: linear-gradient(90deg, var(--sunken-2) 25%, var(--sunken) 50%, var(--sunken-2) 75%);
  background-size: 400% 100%;
  animation: skeleton-shine 1.4s ease infinite;
}

.skeleton-short {
  width: 50%;
}

@keyframes skeleton-shine {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

.manual-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
}

.manual-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: var(--brand-tint);
  color: var(--brand-strong);
  font-weight: 600;
}

.manual-link {
  color: var(--brand);
}

.manual-entry {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-4);
  padding: 12rpx 0 4rpx;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 46, 38, 0.42);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 101;
  background: var(--bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: 36rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.sheet-desc {
  font-size: 24rpx;
  color: var(--text-4);
  line-height: 1.6;
  margin: 8rpx 0 28rpx;
}

.quick-grid {
  display: flex;
  gap: 14rpx;
}

.quick-item {
  flex: 1;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 20rpx 0;
  text-align: center;
}

.quick-item:active {
  background: var(--brand-tint);
  border-color: var(--brand);
}

.quick-label {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.quick-hint {
  font-size: 22rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

.manual-row {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 20rpx;
  padding: 0 28rpx;
  margin: 28rpx 0;
  border: 2rpx solid var(--line);
}

.manual-input {
  flex: 1;
  height: 92rpx;
  font-size: 30rpx;
}

.manual-unit {
  font-size: 28rpx;
  color: var(--text-3);
}
